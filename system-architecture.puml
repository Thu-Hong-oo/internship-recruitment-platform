@startuml System Architecture - Internship Recruitment Platform

!theme plain
skinparam backgroundColor #FFFFFF
skinparam packageStyle rectangle
skinparam linetype polyline
skinparam nodesep 80
skinparam ranksep 100

title System Architecture - AI-Powered Internship Recruitment Platform

' ============================================
' EXTERNAL USERS
' ============================================
actor "Candidate" as Candidate #lightblue
actor "Employer" as Employer #lightgreen
actor "Admin" as Admin #orange

' ============================================
' FRONTEND LAYER
' ============================================
package "Frontend Layer" <<presentation>> #FAFAFA {
    
    frame "Candidate Portal" #E3F2FD {
        component [Next.js 15\nReact 19\nTailwind CSS] as FE_Candidate
    }
    
    frame "Employer Portal" #E8F5E9 {
        component [Next.js 14\nReact 18\nTailwind CSS] as FE_Employer
    }
    
    frame "Admin Dashboard" #FFF3E0 {
        component [React + Vite\nMaterial-UI\nAnt Design] as FE_Admin
    }
}

' ============================================
' INFRASTRUCTURE LAYER
' ============================================
package "Infrastructure Layer" #F5F5F5 {
    component [CDN\nStatic Assets] as CDN
    component [Load Balancer\nNginx] as LB
}

' ============================================
' API GATEWAY
' ============================================
package "API Gateway Layer" #E8EAF6 {
    component [Express.js\nPort 3000] as API_Gateway
    component [Security\nRate Limiting\nHelmet] as Security
    component [JWT Auth\nOAuth 2.0\nbcrypt] as Auth
}

' ============================================
' BACKEND SERVICES
' ============================================
package "Business Logic Layer" <<application>> #E1F5FE {
    
    frame "Core Services" {
        component [User\nManagement] as User_Service
        component [Job\nManagement] as Job_Service
        component [Application\nMatching] as App_Service
        component [Notification\nService] as Notif_Service
    }
    
    frame "AI Services" #FFF9C4 {
        component [CV Analysis\nNLP] as AI_CV
        component [Job Matching\nRecommendation] as AI_Match
        component [Skill Roadmap\nCareer Path] as AI_Roadmap
        component [AI Chatbot] as AI_Chat
    }
    
    frame "File Services" {
        component [File Upload\nMulter] as File_Service
        component [PDF Generator] as PDF_Service
    }
}

' ============================================
' REAL-TIME LAYER
' ============================================
package "Real-time Communication" #FCE4EC {
    component [Socket.io\nWebSocket] as Socket_Server
}

' ============================================
' DATA LAYER
' ============================================
package "Data Layer" <<database>> #C8E6C9 {
    
    database "MongoDB Atlas" as MongoDB {
        collections Users
        collections Jobs
        collections Applications
        collections Profiles
        collections Skills
        collections Notifications
    }
    
    database "Redis Cache" as Redis {
        collections Sessions
        collections Cache
        collections Rate Limits
    }
}

' ============================================
' EXTERNAL SERVICES
' ============================================
package "External Services" #FFE0B2 {
    cloud "Google AI\nGemini API" as Google_AI
    cloud "OpenAI\nGPT Models" as OpenAI
    cloud "Cloudinary\nFile Storage" as Cloudinary
    cloud "Email\nSMTP" as Email
    cloud "Web Crawler\nJob Scraping" as Crawler
}

' ============================================
' USER TO FRONTEND
' ============================================
Candidate -down-> FE_Candidate
Employer -down-> FE_Employer
Admin -down-> FE_Admin

' ============================================
' FRONTEND TO INFRASTRUCTURE
' ============================================
FE_Candidate -down-> CDN
FE_Employer -down-> CDN
FE_Admin -down-> CDN

CDN -down-> LB

' ============================================
' INFRASTRUCTURE TO API GATEWAY
' ============================================
LB -down-> API_Gateway
API_Gateway -down-> Security
Security -down-> Auth

' ============================================
' API GATEWAY TO SERVICES
' ============================================
Auth -down-> User_Service
Auth -down-> Job_Service
Auth -down-> App_Service
Auth -down-> Notif_Service

' ============================================
' CORE SERVICES INTERACTIONS
' ============================================
User_Service -right-> Job_Service
Job_Service -right-> App_Service
App_Service -right-> Notif_Service

' ============================================
' AI SERVICES CONNECTIONS
' ============================================
User_Service -down-> AI_CV
Job_Service -down-> AI_Match
App_Service -down-> AI_Roadmap
Notif_Service -down-> AI_Chat

AI_CV -down-> Google_AI
AI_Match -down-> Google_AI
AI_Roadmap -down-> OpenAI
AI_Chat -down-> OpenAI

' ============================================
' FILE SERVICES
' ============================================
User_Service -down-> File_Service
File_Service -down-> Cloudinary
File_Service -down-> PDF_Service

' ============================================
' DATABASE CONNECTIONS
' ============================================
User_Service -down-> MongoDB
Job_Service -down-> MongoDB
App_Service -down-> MongoDB
Notif_Service -down-> MongoDB

User_Service -down-> Redis
Job_Service -down-> Redis
Auth -down-> Redis

' ============================================
' REAL-TIME CONNECTIONS
' ============================================
Socket_Server -up-> FE_Candidate
Socket_Server -up-> FE_Employer
Socket_Server -up-> FE_Admin

Notif_Service -right-> Socket_Server
Socket_Server -down-> Redis

' ============================================
' EXTERNAL INTEGRATIONS
' ============================================
Notif_Service -down-> Email
Job_Service -down-> Crawler
Crawler -down-> MongoDB

@enduml
