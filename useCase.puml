@startuml
skinparam backgroundColor #FFFFFF
skinparam linetype ortho

skinparam actor {
  BackgroundColor #E3F2FD
  BorderColor #1976D2
  FontSize 12
  FontColor #000000
}

skinparam usecase {
  BackgroundColor #E3F2FD
  BorderColor #1976D2
  BorderThickness 2
  FontSize 11
  FontColor #000000
}

skinparam rectangle {
  BackgroundColor #B3E5FC
  BorderColor #0277BD
  BorderThickness 3
  FontSize 13
  FontColor #000000
  FontStyle bold
}

skinparam arrow {
  Color #1976D2
  Thickness 1.5
}

left to right direction

actor Candidate
actor Employer
actor Admin

rectangle "Hệ thống Tuyển dụng" {
  
  ' === AUTHENTICATION (CHUNG) ===
  (Đăng ký Candidate) as UCCandidateRegister
  (Đăng ký Employer) as UCEmployerRegister
  (Xác thực email) as UCVerifyEmail
  (Đăng nhập) as UCLogin
  (Đăng xuất) as UCLogout
  
  ' === CANDIDATE USE CASES ===
  ' 1.1 Quản lý tài khoản
  (Cập nhật hồ sơ cá nhân) as UCUpdateProfile
  (Cập nhật avatar) as UCUpdateAvatar
  (Đổi mật khẩu) as UCChangePassword
  (Tải CV lên) as UCUploadCV
  (Upload & Parse CV bằng AI) as UCParseCV
  
  ' 1.2 Quản lý CV
  (Xem danh sách CV) as UCViewCVList
  (Xem chi tiết CV) as UCViewCVDetail
  (Đặt CV mặc định) as UCSetDefaultCV
  (Đổi tên CV) as UCRenameCV
  (Xóa CV) as UCDeleteCV
  
  ' Template CV
  (Xem template CV) as UCViewTemplates
  (Tìm template) as UCSearchTemplate
  (Tạo CV từ template) as UCCreateFromTemplate
  (Tải xuống CV đã tạo) as UCDownloadCV
  
  ' Phân tích & Tối ưu
  (Phân tích JD công việc) as UCAnalyzeJD
  (Nhận gợi ý tối ưu CV) as UCSuggestOptimize
  
  ' Job (Không cần đăng nhập)
  (Tìm việc) as UCSearchJob
  (Xem chi tiết việc làm) as UCViewJobDetail
  
  ' Job (Cần đăng nhập)
  (Lưu việc làm) as UCSaveJob
  (Apply việc làm) as UCApplyJob
  (Xem trạng thái ứng tuyển) as UCViewApplicationStatus
  
  ' Thông báo
  (Quản lý thông báo) as UCManageNotification
  (Nhận thông báo) as UCReceiveNotification
  (Ẩn thông báo) as UCHideNotification
  (Tắt thông báo) as UCDisableNotification
  
  ' === EMPLOYER USE CASES ===
  (Quản lý thông tin cá nhân) as UCManageEmployerProfile
  (Quản lý thông tin công ty) as UCManageCompanyInfo
  
  ' Quản lý bài đăng tuyển dụng
  (Quản lý bài đăng tuyển dụng) as UCManageJobPosting
  (Đăng tin tuyển dụng) as UCPostJob
  (Sửa tin tuyển dụng) as UCEditJob
  (Mua gói đăng tin) as UCBuyPackage
  
  ' Quản lý ứng viên
  (Xem danh sách ứng viên) as UCViewCandidateList
  (Xem CV ứng viên - Trả phí) as UCViewCandidateCV
  
  ' === ADMIN USE CASES ===
  (Quản lý người dùng) as UCManageUsers
  (Quản lý Candidate) as UCManageCandidate
  (Quản lý Employer) as UCManageEmployer
  (Quản lý công ty) as UCManageCompany
  (Quản lý bài đăng) as UCManageJobPosts
  (Quản lý ngành đăng) as UCManageIndustry
}

' ===== CANDIDATE CONNECTIONS =====
Candidate --> UCCandidateRegister
Candidate --> UCLogin
Candidate --> UCLogout
Candidate --> UCUpdateProfile
Candidate --> UCUpdateAvatar
Candidate --> UCChangePassword
Candidate --> UCUploadCV
Candidate --> UCViewCVList
Candidate --> UCViewTemplates
Candidate --> UCAnalyzeJD
Candidate --> UCSearchJob
Candidate --> UCViewJobDetail
Candidate --> UCSaveJob
Candidate --> UCApplyJob
Candidate --> UCViewApplicationStatus
Candidate --> UCManageNotification

' ===== EMPLOYER CONNECTIONS =====
Employer --> UCEmployerRegister
Employer --> UCLogin
Employer --> UCLogout
Employer --> UCManageEmployerProfile
Employer --> UCManageCompanyInfo
Employer --> UCManageJobPosting
Employer --> UCViewCandidateList
Employer --> UCViewCandidateCV

' ===== ADMIN CONNECTIONS =====
Admin --> UCLogin
Admin --> UCLogout
Admin --> UCManageUsers
Admin --> UCManageCompany
Admin --> UCManageJobPosts
Admin --> UCManageIndustry

' ===== AUTHENTICATION RELATIONSHIPS =====
UCCandidateRegister ..> UCVerifyEmail : <<include>>
UCEmployerRegister ..> UCVerifyEmail : <<include>>

' ===== CANDIDATE RELATIONSHIPS =====
' Quản lý tài khoản cần đăng nhập
UCUpdateProfile ..> UCLogin : <<include>>
UCUpdateAvatar ..> UCLogin : <<include>>
UCChangePassword ..> UCLogin : <<include>>
UCUploadCV ..> UCLogin : <<include>>

' Upload CV có thể parse bằng AI
UCParseCV ..> UCUploadCV : <<extend>>

' Quản lý CV cần đăng nhập
UCViewCVList ..> UCLogin : <<include>>
UCViewCVDetail ..> UCViewCVList : <<extend>>
UCSetDefaultCV ..> UCViewCVList : <<extend>>
UCRenameCV ..> UCViewCVList : <<extend>>
UCDeleteCV ..> UCViewCVList : <<extend>>

' Template CV
UCSearchTemplate ..> UCViewTemplates : <<extend>>
UCCreateFromTemplate ..> UCViewTemplates : <<extend>>
UCCreateFromTemplate ..> UCLogin : <<include>>
UCDownloadCV ..> UCCreateFromTemplate : <<extend>>

' Phân tích & Tối ưu cần đăng nhập
UCAnalyzeJD ..> UCLogin : <<include>>
UCSuggestOptimize ..> UCAnalyzeJD : <<extend>>

' Job - Tìm việc và xem chi tiết KHÔNG cần đăng nhập
' (không có mũi tên include)

' Job - Các chức năng khác CẦN đăng nhập
UCSaveJob ..> UCLogin : <<include>>
UCApplyJob ..> UCLogin : <<include>>
UCViewApplicationStatus ..> UCLogin : <<include>>

' Thông báo
UCManageNotification ..> UCLogin : <<include>>
UCReceiveNotification ..> UCManageNotification : <<extend>>
UCHideNotification ..> UCManageNotification : <<extend>>
UCDisableNotification ..> UCManageNotification : <<extend>>

' ===== EMPLOYER RELATIONSHIPS =====
UCManageEmployerProfile ..> UCLogin : <<include>>
UCManageCompanyInfo ..> UCLogin : <<include>>

' Quản lý bài đăng
UCManageJobPosting ..> UCLogin : <<include>>
UCPostJob ..> UCManageJobPosting : <<extend>>
UCEditJob ..> UCManageJobPosting : <<extend>>
UCBuyPackage ..> UCManageJobPosting : <<extend>>

' Quản lý ứng viên
UCViewCandidateList ..> UCLogin : <<include>>
UCViewCandidateCV ..> UCViewCandidateList : <<extend>>

' ===== ADMIN RELATIONSHIPS =====
UCManageUsers ..> UCLogin : <<include>>
UCManageCandidate ..> UCManageUsers : <<extend>>
UCManageEmployer ..> UCManageUsers : <<extend>>

UCManageCompany ..> UCLogin : <<include>>
UCManageJobPosts ..> UCLogin : <<include>>
UCManageIndustry ..> UCLogin : <<include>>

@enduml