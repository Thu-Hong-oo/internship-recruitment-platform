@startuml
skinparam backgroundColor #FFFFFF
skinparam linetype ortho
hide stereotype
left to right direction


skinparam actor {
  BackgroundColor #E3F2FD
  BorderColor #1976D2
  FontSize 50
  FontColor #000000
}

skinparam usecase {
  BackgroundColor #E3F2FD
  BorderColor #1976D2
  BorderThickness 2
  FontSize 40
  FontColor #000000
}

skinparam rectangle {
  BackgroundColor #B3E5FC
  BorderColor #0277BD
  BorderThickness 3
  FontSize 50
  FontColor #000000
  FontStyle bold
}

skinparam arrow {
  FontSize 30
  Color #1976D2
  Thickness 3
}
skinparam ArrowMessageAlignment center

' Use case chính được highlight
skinparam usecase<<main>> {
  BackgroundColor #FFE0B2
  BorderColor #FB8C00
  FontColor #E65100
  FontSize 45
  BorderThickness 3
}


skinparam usecase<<login>> {
  BackgroundColor #C8E6C9
  BorderColor #388E3C
  FontColor #1B5E20
  FontSize 50
  BorderThickness 2
}

actor Candidate as "Ứng viên"
actor Employer as "Nhà tuyển dụng"  
actor Admin as "Quản trị viên"

rectangle "HỆ THỐNG" {
  
  ' ========== CHỨC NĂNG ỨNG VIÊN (Đặt trước) ==========
    together {
        together {
            (Quản lý CV) <<main>> as UCManageCV
            (Tải CV lên) as UCUploadCV
            (Phân tích CV bằng AI) as UCParseCV
            (Chọn CV mặc định) as UCSetDefaultCV
            (Đổi tên CV) as UCRenameCV
            (Xóa CV) as UCDeleteCV
            (Tạo CV từ template) as UCCreateFromTemplate
            (Tải xuống CV) as UCDownloadCV
        }

        together {
            (Quản lý tài khoản) <<main>> as UCManageAccount
            (Cập nhật hồ sơ) as UCUpdateProfile
            (Đổi mật khẩu) as UCChangePassword
        }
        
        together {
            (Tìm việc làm) <<main>> as  UCSearchJob
            (Xem chi tiết việc làm) as UCViewJobDetail
            (Lưu việc làm) as UCSaveJob
            (Ứng tuyển) as UCApplyJob
        }

        (Quản lý việc của tôi) <<main>> as UCManageMyJob
        (Quản lý thông báo) <<main>> as UCManageNotification
     }
    together {
        together {
    ' ========== CHỨC NĂNG NHÀ TUYỂN DỤNG ==========
            together {
                (Quản lý thông tin NTD) <<main>> as UCManageEmployerProfile
                (Cập nhật hồ sơ cá nhân/ doanh nghiệp) as UCUpdateEmployerProfile
            }
            together {
                (Quản lý gói dịch vụ NTD) <<main>> as UCManagePackages
                (Gia hạn/ hủy gói \n dịch vụ đã mua) as UCRenewPackages
                (Mua gói dịch vụ) as UCBuyPackages
            }
            (Quản lý bài đăng tuyển dụng) <<main>> as UCManageJobPosting
            (Quản lý ứng viên ứng tuyển) as UCManageCandidatesApplying
        }
        ' ========== CHỨC NĂNG QUẢN TRỊ ==========
        together {
            (Quản lý người dùng) <<main>> as UCManageUsers
            (Quản lý doanh nghiệp) <<main>> as UCManageCompany
            (Quản lý ngành nghề) <<main>> as UCManageIndustry
            (Quản lý bài đăng) <<main>> as UCManageJobPosts
            (Quản lý gói dịch vụ hệ thống) <<main>> as UCManageEmployerPackages
            (Xem thống kê) <<main>> as UCViewStatistics
        }
    }

  
  

     ' ========== XÁC THỰC (CHUNG) - Đặt sau ==========
    together {
        (Đăng nhập) <<login>> as UCLogin
        (Đăng kí) as UCRegister
    }

  

}

' ==========================================
' KẾT NỐI - ỨNG VIÊN (Chỉ nối UC CHÍNH)
' ==========================================

Candidate --> UCManageAccount
Candidate --> UCManageCV
Candidate --> UCSearchJob
Candidate --> UCManageMyJob
Candidate --> UCManageNotification

' ==========================================
' KẾT NỐI - NHÀ TUYỂN DỤNG (Chỉ nối UC CHÍNH)
' ==========================================
' Employer --> UCRegister

Employer --> UCManageEmployerProfile
Employer --> UCManageJobPosting
Employer --> UCManagePackages

' ==========================================
' KẾT NỐI - QUẢN TRỊ VIÊN (Chỉ nối UC CHÍNH)
' ==========================================
' Admin --> UCRegister

Admin --> UCManageUsers
Admin --> UCManageCompany
Admin --> UCManageJobPosts
Admin --> UCManageIndustry
Admin --> UCManageEmployerPackages
Admin --> UCViewStatistics

' ==========================================
' QUAN HỆ - XÁC THỰC
' ==========================================

' ==========================================
' QUAN HỆ - ỨNG VIÊN (Từ UC CHÍNH ra UC PHỤ)
' ==========================================
' Tài khoản - Từ UC chính ra các UC phụ
UCLogin ..> UCRegister : "  <<include>>  "
UCManageAccount ..> UCLogin : "  <<include>>  "
UCManageAccount <.. UCUpdateProfile : <<extend>>
UCManageAccount <.. UCChangePassword : <<extend>>

' CV - Từ UC chính ra các UC phụ
UCManageCV ..> UCLogin : "  <<include>>  "
UCManageCV <.. UCUploadCV : <<extend>>
UCManageCV <.. UCParseCV : <<extend>>
UCManageCV <.. UCSetDefaultCV : <<extend>>
UCManageCV <.. UCRenameCV : <<extend>>
UCManageCV <.. UCDeleteCV : <<extend>>
UCManageCV <.. UCCreateFromTemplate : <<extend>>
UCCreateFromTemplate <.. UCDownloadCV : <<extend>>

' Tìm việc & Apply - Từ UC chính ra các UC phụ
UCSearchJob <.. UCViewJobDetail : <<extend>>
UCViewJobDetail <.. UCSaveJob : <<extend>>
UCViewJobDetail <.. UCApplyJob : <<extend>>
UCSaveJob ..right.. UCLogin : "  <<include>>  "
UCApplyJob ..> UCLogin : "  <<include>>  "

' Quản lý việc đã apply
UCManageMyJob ..> UCLogin : "  <<include>>  "

' Thông báo
UCManageNotification ..> UCLogin : "  <<include>>  "

' ==========================================
' QUAN HỆ - NHÀ TUYỂN DỤNG
' ==========================================
UCManageEmployerProfile ..> UCLogin : "  <<include>>  "
UCUpdateEmployerProfile <.. UCManageEmployerProfile : <<extend>>

UCManageJobPosting ..> UCLogin : "  <<include>>  "
UCManageCandidatesApplying <.. UCManageJobPosting : <<extend>>


UCManagePackages ..> UCLogin : "  <<include>>  "
UCRenewPackages <.. UCManagePackages : <<extend>>
UCBuyPackages <.. UCManagePackages : <<extend>>

' ==========================================
' QUAN HỆ - QUẢN TRỊ VIÊN
' ==========================================
UCManageUsers ..> UCLogin : "  <<include>>  "
UCManageCompany ..> UCLogin : "  <<include>>  "
UCManageJobPosts ..> UCLogin : "  <<include>>  "
UCManageIndustry ..> UCLogin : "  <<include>>  "
UCManageEmployerPackages ..> UCLogin : "  <<include>>  "
UCViewStatistics ..> UCLogin : "  <<include>>  "

@enduml