@startuml
skinparam backgroundColor #FFFFFF
skinparam linetype ortho

skinparam actor {
  BackgroundColor #E3F2FD
  BorderColor #1976D2
  FontSize 12
  FontColor #000000
}

skinparam usecase {
  BackgroundColor #E3F2FD
  BorderColor #1976D2
  BorderThickness 2
  FontSize 15
  FontColor #000000
}

skinparam rectangle {
  BackgroundColor #B3E5FC
  BorderColor #0277BD
  BorderThickness 3
  FontSize 13
  FontColor #000000
  FontStyle bold
}

skinparam arrow {
  Color #1976D2
  Thickness 1.5
  Padding 15
}

skinparam note {
  BackgroundColor #FFF9C4
  BorderColor #F57F17
}

skinparam usecase<<main>> {
  BackgroundColor #FFE0B2
  BorderColor #FB8C00
  FontColor #E65100
  FontSize 18
  BorderThickness 2
}

left to right direction

actor Candidate

rectangle "Hệ thống" {
  together {
  ' === AUTHENTICATION ===
  (Đăng ký tài khoản) as UCRegister
  (Xác thực email) as UCVerifyEmail
  (Đăng nhập) as UCLogin
  (Đăng xuất) as UCLogout
  }

  together {
  ' === 1.1 QUẢN LÝ TÀI KHOẢN ===
  (Quản lý tài khoản) <<main>> as UCManageAccount
  (Cập nhật hồ sơ cá nhân) as UCUpdateProfile
  (Cập nhật avatar) as UCUpdateAvatar
  (Đổi mật khẩu) as UCChangePassword
  }

  ' === 1.2 QUẢN LÝ CV ===
  together {
  (Quản lý CV) <<main>> as UCManageCV
  (Tải CV lên) as UCUploadCV
  (Xem danh sách CV) as UCViewCVList
  (Xem chi tiết CV) as UCViewCVDetail
  (Đặt CV mặc định) as UCSetDefaultCV
  (Đổi tên CV) as UCRenameCV
  (Xóa CV) as UCDeleteCV
  (Phân tích CV bằng AI) as UCParseCV
  
  ' Template CV
  
  (Xem template CV) as UCViewTemplates
  (Tìm kiếm template) as UCSearchTemplate
  (Tạo CV từ template) as UCCreateFromTemplate
  (Tải xuống CV) as UCDownloadCV
  
  ' Phân tích & Tối ưu
  (Phân tích JD công việc) as UCAnalyzeJD
  (Nhận gợi ý tối ưu CV) as UCSuggestOptimize
   }
   together {
  ' === TÌM VIỆC & ỨNG TUYỂN ===
  (Tìm việc làm) as UCSearchJob
  (Xem chi tiết việc làm) as UCViewJobDetail
  (Lưu việc làm) as UCSaveJob
  (Ứng tuyển việc làm) as UCApplyJob
  (Xem trạng thái ứng tuyển) as UCViewApplicationStatus
   }
  ' === QUẢN LÝ THÔNG BÁO ===
  together {
  (Quản lý thông báo) <<main>> as UCManageNotification
  (Nhận thông báo) as UCReceiveNotification
  (Ẩn thông báo) as UCHideNotification
  (Tắt thông báo) as UCDisableNotification
  }
}

' ===== CANDIDATE CONNECTIONS =====
Candidate --> UCRegister
Candidate --> UCLogin
Candidate --> UCLogout
Candidate --> UCManageAccount
Candidate --> UCManageCV
Candidate --> UCSearchJob
Candidate --> UCViewJobDetail
Candidate --> UCSaveJob
Candidate --> UCApplyJob
Candidate --> UCViewApplicationStatus
Candidate --> UCManageNotification

' ===== AUTHENTICATION =====
UCRegister ..> UCVerifyEmail : <<include>>

' ===== 1.1 QUẢN LÝ TÀI KHOẢN =====
UCManageAccount ..> UCUpdateProfile : <<include>>
UCManageAccount ..> UCUpdateAvatar : <<include>>
UCManageAccount ..> UCChangePassword : <<include>>

UCParseCV ..> UCUploadCV : <<extend>>

' ===== 1.2 QUẢN LÝ CV =====
UCManageCV ..> UCUploadCV : <<include>>
UCManageCV ..> UCViewCVList : <<include>>
UCViewCVDetail ..> UCViewCVList : <<extend>>
UCSetDefaultCV ..> UCViewCVList : <<extend>>
UCRenameCV ..> UCViewCVList : <<extend>>
UCDeleteCV ..> UCViewCVList : <<extend>>

' Template CV
UCManageCV ..> UCViewTemplates : <<include>>
UCSearchTemplate ..> UCViewTemplates : <<extend>>
UCCreateFromTemplate ..> UCViewTemplates : <<extend>>
UCDownloadCV ..> UCCreateFromTemplate : <<extend>>

' Phân tích & Tối ưu
UCManageCV ..> UCAnalyzeJD : <<include>>
UCSuggestOptimize ..> UCAnalyzeJD : <<extend>>

' ===== TÌM VIỆC & ỨNG TUYỂN =====
' Tìm việc và xem chi tiết KHÔNG cần đăng nhập (không có quan hệ với Login)

' Các chức năng CẦN đăng nhập
UCSaveJob ..> UCViewJobDetail : <<extend>>
UCApplyJob ..> UCViewJobDetail : <<extend>>

' ===== QUẢN LÝ THÔNG BÁO =====
UCManageNotification ..> UCReceiveNotification : <<include>>
UCHideNotification ..> UCManageNotification : <<extend>>
UCDisableNotification ..> UCManageNotification : <<extend>>


@enduml