# ============================================================
# 🤖 RAG (Retrieval-Augmented Generation) Configuration
# ============================================================
# Multi-Industry Learning Resources System
# Supports: Technology, Marketing, Business, Design, Accounting,
# Healthcare, Education, Engineering, Hospitality, Law, Media, Logistics

# ChromaDB Vector Database
CHROMADB_URL=http://localhost:8000
# ChromaDB stores embeddings for semantic search of learning resources
# Default: runs locally on port 8000
# Production: Use ChromaDB cloud or self-hosted instance

# YouTube Data API v3
YOUTUBE_API_KEY=your_youtube_api_key_here
# Get API key from: https://console.cloud.google.com/apis/credentials
# 1. Create/Select a Google Cloud project
# 2. Enable YouTube Data API v3
# 3. Create credentials (API Key)
# 4. Restrict the key to YouTube Data API v3
# Free tier: 10,000 units/day (sufficient for ~300 searches/day)

# GitHub API (Optional but recommended for Technology/Engineering)
GITHUB_TOKEN=your_github_personal_access_token_here
# Get token from: https://github.com/settings/tokens
# Scopes needed: public_repo (read-only)
# Without token: 60 requests/hour
# With token: 5,000 requests/hour
# Note: Token is optional but increases rate limits significantly

# Coursera API (For Business/Marketing/Design/Accounting/Healthcare/Education)
COURSERA_API_KEY=your_coursera_api_key_here
# Note: Coursera API requires partnership/enterprise agreement
# This service uses mock data for demonstration purposes
# For production: Contact Coursera for API access or use web scraping
# Alternative: Use Udemy API, LinkedIn Learning API, or edX API

# ============================================================
# 📊 RAG Service Configuration
# ============================================================

# Enable RAG service (set to 'false' to use legacy AI-only generation)
ENABLE_RAG=true

# Minimum credibility threshold (0-1 scale)
RAG_MIN_CREDIBILITY=0.65

# Maximum resources per skill
RAG_MAX_RESOURCES_PER_SKILL=5

# Resource types to fetch
RAG_RESOURCE_TYPES=video,project,documentation,course

# ============================================================
# 🏭 Industry-Specific Data Source Priorities
# ============================================================
# Technology: YouTube + GitHub + VectorDB
# Marketing/Business: Coursera + YouTube + VectorDB
# Design: Coursera + YouTube + VectorDB
# Accounting/Finance: Coursera + YouTube + VectorDB
# Healthcare/Education: Coursera + YouTube + VectorDB
# Engineering: YouTube + Coursera + GitHub + VectorDB

# ============================================================
# 🎓 Academic Validation Settings (For Thesis)
# ============================================================

# Enable verification tracking
ENABLE_VERIFICATION_TRACKING=true

# Enable citation generation
ENABLE_CITATIONS=true

# Academic mode (adds extra validation and documentation)
ACADEMIC_MODE=true

# ============================================================
# 🗄️ Running ChromaDB Locally
# ============================================================
# Option 1: Using Docker (Recommended)
# docker run -d -p 8000:8000 chromadb/chroma
#
# Option 2: Using Python
# pip install chromadb
# chroma run --path ./chroma_data --port 8000
#
# Verify: curl http://localhost:8000/api/v1/heartbeat

# ============================================================
# 📚 How to Get API Keys
# ============================================================
#
# YOUTUBE_API_KEY:
# 1. Go to https://console.cloud.google.com/
# 2. Create new project or select existing
# 3. Enable "YouTube Data API v3"
# 4. Go to Credentials → Create Credentials → API Key
# 5. Restrict key to YouTube Data API v3
# 6. Copy the API key here
#
# GITHUB_TOKEN:
# 1. Go to https://github.com/settings/tokens
# 2. Click "Generate new token (classic)"
# 3. Select scope: "public_repo"
# 4. Generate token and copy here
# 5. Token is optional but recommended
#
# ============================================================
# 🚀 Quick Start Guide
# ============================================================
#
# 1. Copy this file to .env
# 2. Add your API keys (YouTube required, GitHub optional)
# 3. Start ChromaDB: docker run -d -p 8000:8000 chromadb/chroma
# 4. Populate vector database: node scripts/populateVectorDB.js populate
# 5. Verify health: curl http://localhost:3000/api/nlp/rag-health
# 6. Generate RAG roadmap: POST /api/nlp/learning-roadmap-rag
#
