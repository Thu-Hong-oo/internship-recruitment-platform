@startuml
' Cấu hình chung cho sơ đồ
skinparam linetype ortho
skinparam shadowing false
set separator none

skinparam class {
    BorderColor #2a4c6a
    BackgroundColor #eaf2f8
    ArrowColor #2a4c6a
}

hide empty members

' =========================================================================
' CORE USER MANAGEMENT
' =========================================================================
class User {
    + _id : ObjectId
    + email : String {unique}
    - password : String {select:false}
    + authMethod : String [local|google|hdybrid]
    + googleId : String {sparse}
    + fullName : String
    + avatar : String (URL)
    + role : String
    + preferences : JSON
    + isEmailVerified : Boolean
    + isActive : Boolean
    + status : String
    + candidateProfile : ObjectId
    + employerProfile : ObjectId
    --
    + getSignedJwtToken() : String
    + matchPassword(enteredPassword: String) : Boolean
    + canUsePassword() : Boolean
    + isAccountActive() : Boolean
    + isAccountLocked() : Boolean
    + updateStatus(newStatus: String, reason: String, adminId: ObjectId)
}

class CandidateProfile {
    + _id : ObjectId
    + userId : ObjectId {unique}
    + status : String [active|inactive|paused]
    + settings : JSON
    + personalInfo : JSON
    + targetJob : JSON
    + education : Array<JSON>
    + experience : Array<JSON>
    + skills : JSON
    + preferences : JSON
    + resume : JSON
    + progress : JSON
    + analytics : JSON
    + followedCompanies : Array<ObjectId>
    --
    + updateProfileCompletion()
    + updateSkillVerification()
    + incrementViews()
}

class EmployerProfile {
    + _id : ObjectId
    + owner : ObjectId {unique}
    + company : JSON
    + businessInfo : JSON
    + position : JSON
    + legalRepresentative : JSON
    + contact : JSON
    + members : Array<JSON>
    + verification : JSON
    + status : JSON
    + stats : JSON
    + ai : JSON
    + reputation : JSON
    + engagement : JSON
    + subscription : JSON
    --
    + addMember(userId: ObjectId, role: String)
    + removeMember(userId: ObjectId)
    + userCan(userId: ObjectId, permission: String) : Boolean
    + getActiveMembers() : Array<User>
    + canPostNewJob() : Boolean
    + updateStats()
    + incrementView()
    + findVerified() {static} : Array<EmployerProfile>
    + findByIndustry(industry: String) {static} : Array<EmployerProfile>
    + findCanPostJobs() {static} : Array<EmployerProfile>
    + search(query: String) {static} : Array<EmployerProfile>
}

' =========================================================================
' JOB & APPLICATION MANAGEMENT
' =========================================================================
class Job {
    + _id : ObjectId
    + employer : ObjectId
    + postedBy : ObjectId
    + title : String
    + slug : String {unique}
    + description : String
    + requirements : String
    + skills : Array<String>
    + skillIds : Array<ObjectId>
    + industryCode : String
    + subIndustryCode : String
    + industryPath : Array<String>
    + level : String
    + jobType : String
    + workingMode : String
    + location : String
    + salaryMin : Number
    + salaryMax : Number
    + deadline : Date
    + status : String
    + views : Number
    + stats : JSON
    + ai : JSON
    + deletedAt : Date
}

class Application {
    + _id : ObjectId
    + candidateId : ObjectId
    + jobId : ObjectId
    + status : String
    + coverLetter : String
    + attachments : Array<JSON>
    + resume : JSON
    + matchingScore : JSON
    + interviews : Array<JSON>
    + timeline : Array<JSON>
    + feedback : JSON
    + aiAnalysis : JSON
    --
    + updateStatus(status: String, note: String, userId: ObjectId)
    + scheduleInterview(interviewData: JSON)
    + addFeedback(feedbackData: JSON)
}

class SavedJob {
    + _id : ObjectId
    + candidateId : ObjectId
    + jobId : ObjectId
    + savedAt : Date
    + notes : String
}

' =========================================================================
' AI & ANALYSIS SYSTEM
' =========================================================================
class AIAnalysis {
    + _id : ObjectId
    + sourceType : String [cv/job/skill_assessment]
    + sourceId : ObjectId
    + content : JSON
    + nlpResults : JSON
    + matchingAnalysis : JSON
    + metadata : JSON
}

class JobRecommendation {
    + _id : ObjectId
    + candidateId : ObjectId
    + recommendations : Array<JSON>
    + filters : JSON
    + generatedAt : Date
    + expiresAt : Date
    + isStale : Boolean
}

class CandidateRecommendation {
    + _id : ObjectId
    + jobId : ObjectId
    + recommendations : Array<JSON>
    + generatedAt : Date
    + expiresAt : Date
    + isStale : Boolean
}

' =========================================================================
' SKILLS & LEARNING SYSTEM
' =========================================================================
class Skill {
    + _id : ObjectId
    + name : String {unique}
    + category : String
    + aliases : Array<String>
    + description : String
    + embedding : Array<Number> (Vector)
    + popularity : Number
    + demandLevel : String
    + trend : String
}

class SkillCategory {
    + _id : ObjectId
    + name : String {unique}
    + slug : String {unique}
    + description : String
    + icon : String (URL)
    + color : String
    + parentCategory : ObjectId
    + isActive : Boolean
    + sortOrder : Number
    + metadata : JSON
}

class SkillRoadmap {
    + _id : ObjectId
    + internId : ObjectId
    + targetJob : JSON
    + analysis : JSON
    + roadmap : JSON
    + progress : JSON
    + mentorship : JSON
    + status : String
}

class SkillLearningPath {
    + _id : ObjectId
    + skillId : ObjectId
    + levels : Array<JSON>
    + prerequisites : Array<String>
    + resources : Array<JSON>
    + milestones : Array<JSON>
    + careerPaths : Array<String>
    + relatedSkills : Array<ObjectId>
    + marketData : JSON
    + isActive : Boolean
}

' =========================================================================
' COMMUNICATION & NOTIFICATIONS
' =========================================================================
class Notification {
    + _id : ObjectId
    + recipient : ObjectId
    + sender : ObjectId
    + type : String
    + title : String
    + message : String
    + data : JSON
    + isRead : Boolean
    + isSent : Boolean
}

class Message {
    + _id : ObjectId
    + conversationId : ObjectId
    + senderId : ObjectId
    + content : String
    + attachments : Array<JSON>
    + readBy : Array<ObjectId>
}

class Conversation {
    + _id : ObjectId
    + participants : Array<ObjectId>
    + lastMessageId : ObjectId
    + lastMessageAt : Date
    + unreadCountByUser : Map (String: Number)
}

' =========================================================================
' INDUSTRY & BUSINESS CONTEXT
' =========================================================================
class Industry {
    + _id : ObjectId
    + code : String {unique}
    + parentCode : String
    + name : JSON
    + description : JSON
    + color : String
    + icon : String (URL)
    + keywords : Array<String>
    + visible : Boolean
}

class CompanyFollow {
    + _id : ObjectId
    + candidateId : ObjectId
    + employerId : ObjectId
    + createdAt : Date
    + deletedAt : Date
}

' =========================================================================
' BILLING & WEBHOOKS
' =========================================================================
class Subscription {
    + _id : ObjectId
    + owner : ObjectId
    + planCode : String
    + status : String
    + startDate : Date
    + endDate : Date
    + autoRenew : Boolean
}

class Invoice {
    + _id : ObjectId
    + owner : ObjectId
    + amount : Number
    + currency : String
    + items : Array<JSON>
    + status : String
    + dueDate : Date
}

class Webhook {
    + _id : ObjectId
    + name : String
    + url : String
    + secret : String
    + isActive : Boolean
}

class WebhookEvent {
    + _id : ObjectId
    + webhookId : ObjectId
    + type : String
    + payload : JSON
    + status : String
}

' =========================================================================
' RELATIONSHIPS
' =========================================================================

' CORE USER MANAGEMENT
User "1" -- "1" CandidateProfile : has
User "1" -- "1" EmployerProfile : owns

' JOB & APPLICATION MANAGEMENT
EmployerProfile "1" -- "*" Job : posts
Job "1" -- "*" Application : receives
CandidateProfile "1" -- "*" Application : applies
CandidateProfile "1" -- "*" SavedJob : saves
Job "1" -- "*" SavedJob : savedBy
Job "many" -- "1" Industry : belongs to

' AI & ANALYSIS SYSTEM
CandidateProfile "1" -- "*" AIAnalysis : CV Analysis
Job "1" -- "*" AIAnalysis : Job Analysis
CandidateProfile "1" -- "1" JobRecommendation : is for
Job "1" -- "1" CandidateRecommendation : is for

' SKILLS & LEARNING SYSTEM
SkillCategory "1" -- "*" Skill : contains
SkillCategory "1" -- "*" SkillCategory : subcategories
CandidateProfile "1" -- "*" SkillRoadmap : has
Skill "1" -- "1" SkillLearningPath : for

' COMMUNICATION & NOTIFICATIONS
User "1" -- "*" Notification : receives
User "*" -- "*" Conversation : participates
Conversation "1" -- "*" Message : contains
Message "1" -- "1" Conversation : lastMessage

' INDUSTRY & BUSINESS CONTEXT
CandidateProfile "1" -- "*" CompanyFollow : follows
EmployerProfile "1" -- "*" CompanyFollow : followedBy
CandidateProfile "*" -- "*" EmployerProfile : follows (via CompanyFollow)

' BILLING & WEBHOOKS
EmployerProfile "1" -- "*" Subscription : owns
EmployerProfile "1" -- "*" Invoice : billed
Webhook "1" -- "*" WebhookEvent : emits

@enduml