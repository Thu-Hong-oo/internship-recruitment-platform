{
  "name": "internship-ai-platform-backend",
  "version": "1.0.0",
  "main": "server.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "start": "node server.js",
    "dev": "nodemon server.js",
    "prod": "node server.js",
    "check-env": "node scripts/check-env.js",
    "test-api": "node -e \"require('http').get('http://localhost:3000/health', (r) => {let d='';r.on('data',c=>d+=c);r.on('end',()=>{console.log(r.statusCode===200?'✅ Health check OK':'❌ Health check failed');process.exit(r.statusCode===200?0:1)})}).on('error',e=>{console.error('❌ Server not running:',e.message);process.exit(1)})\"",
    "test-api:ps1": "powershell -ExecutionPolicy Bypass -File scripts/test-api.ps1",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,css,scss,md}\"",
    "format:check": "prettier --check \"**/*.{js,jsx,ts,tsx,json,css,scss,md}\"",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx --max-warnings 1000",
    "lint:fix": "eslint . --ext .js,.jsx,.ts,.tsx --fix"
  },
  "keywords": [
    "internship",
    "ai",
    "nlp",
    "recruitment",
    "nodejs"
  ],
  "author": "",
  "license": "ISC",
  "description": "AI-powered internship recruitment platform with NLP analysis and personalized skill roadmaps",
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "axios": "^1.13.2",
    "bcrypt": "^6.0.0",
    "bcryptjs": "^3.0.2",
    "cheerio": "^1.1.2",
    "chromadb": "^3.1.4",
    "cloudinary": "^1.41.3",
    "compression": "^1.8.1",
    "compromise": "^14.10.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.1",
    "express": "^4.18.2",
    "express-async-handler": "^1.2.0",
    "express-rate-limit": "^7.5.1",
    "express-validator": "^7.0.1",
    "google-auth-library": "^10.3.0",
    "googleapis": "^166.0.0",
    "helmet": "^7.2.0",
    "ioredis": "^5.7.0",
    "joi": "^17.11.0",
    "jsonwebtoken": "^9.0.2",
    "mammoth": "^1.6.0",
    "mongoose": "^8.17.1",
    "multer": "^1.4.5-lts.1",
    "multer-storage-cloudinary": "^4.0.0",
    "natural": "^6.10.4",
    "node-cron": "^4.2.1",
