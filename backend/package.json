{
  "name": "internship-ai-platform-backend",
  "version": "1.0.0",
  "main": "server.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "start": "node server.js",
    "dev": "nodemon server.js",
    "prod": "node server.js",
    "check-env": "node scripts/check-env.js",
    "test-api": "node -e \"require('http').get('http://localhost:3000/health', (r) => {let d='';r.on('data',c=>d+=c);r.on('end',()=>{console.log(r.statusCode===200?'✅ Health check OK':'❌ Health check failed');process.exit(r.statusCode===200?0:1)})}).on('error',e=>{console.error('❌ Server not running:',e.message);process.exit(1)})\"",
    "test-api:ps1": "powershell -ExecutionPolicy Bypass -File scripts/test-api.ps1",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,css,scss,md}\"",
    "format:check": "prettier --check \"**/*.{js,jsx,ts,tsx,json,css,scss,md}\"",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx --max-warnings 1000",
    "lint:fix": "eslint . --ext .js,.jsx,.ts,.tsx --fix",
    "populate-vector-db": "node scripts/populate-vector-db.js",
    "reset-chromadb": "node scripts/reset-chromadb.js",
    "test-local-models": "node scripts/test-local-models.js",
    "export-training-data": "node scripts/export-training-data.js",
    "setup-ollama": "powershell -ExecutionPolicy Bypass -File scripts/setup-ollama-windows.ps1",
    "setup-ollama-docker": "powershell -ExecutionPolicy Bypass -File scripts/setup-ollama-docker.ps1",
    "ollama:start": "docker-compose -f docker-compose.ollama.yml up -d",
    "ollama:stop": "docker-compose -f docker-compose.ollama.yml down",
    "ollama:logs": "docker-compose -f docker-compose.ollama.yml logs -f",
    "ollama:pull": "docker exec -it ollama ollama pull",
    "ollama:check": "node scripts/check-ollama-models.js",
    "ollama:test": "node scripts/test-ollama-complete.js",
    "ollama:test:ps1": "powershell -ExecutionPolicy Bypass -File scripts/test-ollama.ps1",
    "ollama:fix": "node scripts/fix-ollama-model.js",
    "rag:populate": "node scripts/populateVectorDB.js populate",
    "rag:refresh": "node scripts/populateVectorDB.js refresh",
    "rag:health": "node scripts/populateVectorDB.js health",
    "rag:clear": "node scripts/populateVectorDB.js clear",
    "ollama:optimize": "node scripts/optimize-ollama-speed.js",
    "ollama:create-custom": "node scripts/create-custom-ollama-model.js",
    "cleanup:certifications": "node scripts/cleanup-duplicate-certifications.js",
    "cleanup:certifications:execute": "node scripts/cleanup-duplicate-certifications.js --execute"
  },
  "keywords": [
    "internship",
    "ai",
    "nlp",
    "recruitment",
    "nodejs"
  ],
  "author": "",
  "license": "ISC",
  "description": "AI-powered internship recruitment platform with NLP analysis and personalized skill roadmaps",
  "dependencies": {
    "@chroma-core/default-embed": "^0.1.9",
    "@google/generative-ai": "^0.24.1",
    "@huggingface/inference": "^4.13.4",
    "@langchain/community": "^1.0.6",
    "@langchain/core": "^1.1.2",
    "@xenova/transformers": "^2.17.2",
    "axios": "^1.13.2",
    "bcrypt": "^6.0.0",
    "bcryptjs": "^3.0.2",
    "cheerio": "^1.1.2",
    "chromadb": "^3.1.4",
    "cloudinary": "^1.41.3",
    "compression": "^1.8.1",
    "compromise": "^14.10.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.2",
    "express-async-handler": "^1.2.0",
    "express-rate-limit": "^7.5.1",
    "express-validator": "^7.0.1",
    "google-auth-library": "^10.3.0",
    "googleapis": "^166.0.0",
    "helmet": "^7.2.0",
    "ioredis": "^5.7.0",
    "joi": "^17.11.0",
    "jsonwebtoken": "^9.0.2",
    "mammoth": "^1.6.0",
    "mongoose": "^8.17.1",
    "multer": "^1.4.5-lts.1",
    "multer-storage-cloudinary": "^4.0.0",
    "natural": "^6.10.4",
    "node-cron": "^4.2.1",
    "node-fetch": "^3.3.2",
    "node-nlp": "^4.27.0",
    "nodemailer": "^6.9.7",
    "nodemon": "^3.1.10",
    "openai": "^4.104.0",
    "pdf-parse": "^1.1.1",
    "puppeteer": "^24.23.0",
    "redis": "^4.6.11",
    "sharp": "^0.32.6",
    "socket.io": "^4.7.4",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^9.0.1",
    "winston": "^3.11.0",
    "youtube-sr": "^4.3.12"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.1.0",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "supertest": "^6.3.3"
  }
}
