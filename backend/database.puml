@startuml
set separator none
skinparam linetype ortho
skinparam shadowing false
hide empty methods
hide circle

' =========================================================================
' CORE USER MANAGEMENT
' =========================================================================
entity User {
  * _id : ObjectId <<PK>>
  --
  * email : String {unique}
  password : String
  authMethod : String
  googleId : String {sparse}
  fullName : String
  avatar : String (URL)
  role : String
  preferences : JSON
  isEmailVerified : Boolean
  isActive : Boolean
  status : String
}

entity CandidateProfile {
  * _id : ObjectId <<PK>>
  --
  * userId : ObjectId <<FK>> {unique}
  status : String
  settings : JSON
  personalInfo : JSON
  targetJob : JSON
  education : Array<JSON>
  experience : Array<JSON>
  skills : JSON
  preferences : JSON
  resume : JSON
  progress : JSON
  analytics : JSON
  followedCompanies : Array<ObjectId>
}

entity EmployerProfile {
  * _id : ObjectId <<PK>>
  --
  * owner : ObjectId <<FK>> {unique}
  company : JSON
  businessInfo : JSON
  position : JSON
  legalRepresentative : JSON
  contact : JSON
  members : Array<JSON>
  verification : JSON
  status : JSON
  stats : JSON
  ai : JSON
  reputation : JSON
  engagement : JSON
  subscription : JSON
}

' =========================================================================
' JOB & APPLICATION MANAGEMENT
' =========================================================================
entity Job {
  * _id : ObjectId <<PK>>
  --
  * employer : ObjectId <<FK>>
  * postedBy : ObjectId <<FK>>
  title : String
  * slug : String {unique}
  description : String
  requirements : String
  skills : Array<String>
  skillIds : Array<ObjectId>
  industryCode : String
  subIndustryCode : String
  industryPath : Array<String>
  level : String
  jobType : String
  workingMode : String
  location : String
  salaryMin : Number
  salaryMax : Number
  deadline : Date
  status : String
  views : Number
  stats : JSON
  ai : JSON
  deletedAt : Date
}

entity Application {
  * _id : ObjectId <<PK>>
  --
  * candidateId : ObjectId <<FK>>
  * jobId : ObjectId <<FK>>
  status : String
  coverLetter : String
  attachments : Array<JSON>
  resume : JSON
  matchingScore : JSON
  interviews : Array<JSON>
  timeline : Array<JSON>
  feedback : JSON
  aiAnalysis : JSON
}

entity SavedJob {
  * _id : ObjectId <<PK>>
  --
  * candidateId : ObjectId <<FK>>
  * jobId : ObjectId <<FK>>
  savedAt : Date
  notes : String
}

' =========================================================================
' AI & ANALYSIS SYSTEM
' =========================================================================
entity AIAnalysis {
  * _id : ObjectId <<PK>>
  --
  sourceType : String
  sourceId : ObjectId
  content : JSON
  nlpResults : JSON
  matchingAnalysis : JSON
  metadata : JSON
}

entity JobRecommendation {
  * _id : ObjectId <<PK>>
  --
  * candidateId : ObjectId <<FK>>
  recommendations : Array<JSON>
  filters : JSON
  generatedAt : Date
  expiresAt : Date
  isStale : Boolean
}

entity CandidateRecommendation {
  * _id : ObjectId <<PK>>
  --
  * jobId : ObjectId <<FK>>
  recommendations : Array<JSON>
  generatedAt : Date
  expiresAt : Date
  isStale : Boolean
}

' =========================================================================
' SKILLS & LEARNING SYSTEM
' =========================================================================
entity Skill {
  * _id : ObjectId <<PK>>
  --
  * name : String {unique}
  category : String
  aliases : Array<String>
  description : String
  embedding : Array<Number>
  popularity : Number
  demandLevel : String
  trend : String
}

entity SkillCategory {
  * _id : ObjectId <<PK>>
  --
  * name : String {unique}
  * slug : String {unique}
  description : String
  icon : String (URL)
  color : String
  parentCategory : ObjectId <<FK>>
  isActive : Boolean
  sortOrder : Number
  metadata : JSON
}

entity SkillRoadmap {
  * _id : ObjectId <<PK>>
  --
  * internId : ObjectId <<FK>>
  targetJob : JSON
  analysis : JSON
  roadmap : JSON
  progress : JSON
  mentorship : JSON
  status : String
}

entity SkillLearningPath {
  * _id : ObjectId <<PK>>
  --
  * skillId : ObjectId <<FK>>
  levels : Array<JSON>
  prerequisites : Array<String>
  resources : Array<JSON>
  milestones : Array<JSON>
  careerPaths : Array<String>
  relatedSkills : Array<ObjectId>
  marketData : JSON
  isActive : Boolean
}

' =========================================================================
' COMMUNICATION & NOTIFICATIONS
' =========================================================================
entity Notification {
  * _id : ObjectId <<PK>>
  --
  * recipient : ObjectId <<FK>>
  sender : ObjectId
  type : String
  title : String
  message : String
  data : JSON
  isRead : Boolean
  isSent : Boolean
}

entity Message {
  * _id : ObjectId <<PK>>
  --
  * conversationId : ObjectId <<FK>>
  * senderId : ObjectId <<FK>>
  content : String
  attachments : Array<JSON>
  readBy : Array<ObjectId>
}

entity Conversation {
  * _id : ObjectId <<PK>>
  --
  participants : Array<ObjectId>
  lastMessageId : ObjectId <<FK>>
  lastMessageAt : Date
  unreadCountByUser : Map (String: Number)
}

' =========================================================================
' INDUSTRY & BUSINESS CONTEXT
' =========================================================================
entity Industry {
  * _id : ObjectId <<PK>>
  --
  * code : String {unique}
  parentCode : String <<FK>>
  name : JSON
  description : JSON
  color : String
  icon : String (URL)
  keywords : Array<String>
  visible : Boolean
}

entity CompanyFollow {
  * _id : ObjectId <<PK>>
  --
  * candidateId : ObjectId <<FK>>
  * employerId : ObjectId <<FK>>
  createdAt : Date
  deletedAt : Date
}

' =========================================================================
' BILLING & WEBHOOKS
' =========================================================================
entity Subscription {
  * _id : ObjectId <<PK>>
  --
  * owner : ObjectId <<FK>>
  planCode : String
  status : String
  startDate : Date
  endDate : Date
  autoRenew : Boolean
}

entity Invoice {
  * _id : ObjectId <<PK>>
  --
  * owner : ObjectId <<FK>>
  amount : Number
  currency : String
  items : Array<JSON>
  status : String
  dueDate : Date
}

entity Webhook {
  * _id : ObjectId <<PK>>
  --
  name : String
  url : String
  secret : String
  isActive : Boolean
}

entity WebhookEvent {
  * _id : ObjectId <<PK>>
  --
  * webhookId : ObjectId <<FK>>
  type : String
  payload : JSON
  status : String
}

' =========================================================================
' MAPPING & RELATIONSHIPS
' =========================================================================

' Mối quan hệ Một-Một (1-1)
User "1" -- "1" CandidateProfile
User "1" -- "1" EmployerProfile

' Mối quan hệ Một-Nhiều (1-*)
EmployerProfile "1" --> "*" Job
Job "1" --> "*" Application
CandidateProfile "1" --> "*" Application
Job "1" --> "*" SavedJob
CandidateProfile "1" --> "*" SavedJob
Job "1" --> "1" Industry
SkillCategory "1" --> "*" Skill
SkillCategory "1" -- "*" SkillCategory : "parent/child"
CandidateProfile "1" --> "1" JobRecommendation
Job "1" --> "1" CandidateRecommendation
CandidateProfile "1" --> "*" SkillRoadmap
Skill "1" --> "1" SkillLearningPath
User "1" --> "*" Notification
Conversation "1" --> "*" Message
EmployerProfile "1" --> "*" Subscription
EmployerProfile "1" --> "*" Invoice
Webhook "1" --> "*" WebhookEvent
Message "1" --> "1" Conversation : "last message of"

' Mối quan hệ Nhiều-Nhiều (M-N)
' Sử dụng các bảng trung gian để giải quyết mối quan hệ nhiều-nhiều
User "1" - "1" Conversation
User "1" --> "*" Conversation : participants (thông qua mảng)
' Tuy nhiên, tốt nhất nên sử dụng bảng trung gian nếu là SQL:
' entity UserConversation {
'   * userId : ObjectId <<FK>>
'   * conversationId : ObjectId <<FK>>
' }
' User "1" - "*" UserConversation
' Conversation "1" - "*" UserConversation

' Mối quan hệ này đã được xử lý đúng trong sơ đồ của bạn bằng một bảng liên kết rõ ràng
CandidateProfile "1" --> "*" CompanyFollow
EmployerProfile "1" --> "*" CompanyFollow

' Sơ đồ này vẫn giữ mô hình NoSQL với các mảng ObjectId, nhưng
' thể hiện các mối quan hệ một cách tường minh hơn.
@enduml