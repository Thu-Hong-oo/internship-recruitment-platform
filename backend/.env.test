# ===========================================
# TEST ENVIRONMENT CONFIGURATION
# ===========================================

# Server Configuration
PORT=3001
NODE_ENV=test
API_VERSION=1.0.0

# Database Configuration (Test Database)
MONGO_URI=mongodb://localhost:27017/internship_platform_test
REDIS_URL=redis://localhost:6379/1

# Authentication & Security (Test Keys)
JWT_SECRET=test-jwt-secret-key-for-testing-only
JWT_REFRESH_SECRET=test-refresh-token-secret-for-testing
JWT_EXPIRE=1h
BCRYPT_ROUNDS=8

# Email Service (Mocked in tests)
EMAIL_FROM_NAME=Test Internship Platform
EMAIL_FROM_ADDRESS=test@internship-platform.com
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=test
SMTP_PASS=test

# File Storage (Mocked in tests)
CLOUDINARY_CLOUD_NAME=test-cloud
CLOUDINARY_API_KEY=test-api-key
CLOUDINARY_API_SECRET=test-api-secret

# AI Services (Mocked in tests)
GOOGLE_AI_API_KEY=test-google-ai-key
OPENAI_API_KEY=test-openai-key

# Frontend Integration
FRONTEND_URL=http://localhost:3001

# Logging & Monitoring
LOG_LEVEL=error

# Feature Flags
ENABLE_EMAIL_VERIFICATION=false
ENABLE_RATE_LIMITING=false
ENABLE_REDIS_CACHING=false