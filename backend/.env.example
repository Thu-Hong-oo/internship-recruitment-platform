# ===========================================
# INTERNSHIP RECRUITMENT PLATFORM - CONFIG
# ===========================================

# -----------------------------------
# SERVER CONFIGURATION
# -----------------------------------
PORT=3000
NODE_ENV=development
API_VERSION=1.0.0

# -----------------------------------
# DATABASE CONFIGURATION
# -----------------------------------
MONGO_URI=mongodb://localhost:27017/internship_platform
REDIS_URL=redis://localhost:6379

# -----------------------------------
# AUTHENTICATION & SECURITY
# -----------------------------------
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_REFRESH_SECRET=your-refresh-token-secret-change-this-too
JWT_EXPIRE=30d
BCRYPT_ROUNDS=12

# -----------------------------------
# EMAIL SERVICE (SMTP)
# -----------------------------------
EMAIL_FROM_NAME=Internship Platform
EMAIL_FROM_ADDRESS=noreply@internship-platform.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# -----------------------------------
# FILE STORAGE (Cloudinary)
# -----------------------------------
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# -----------------------------------
# AI SERVICES (Google AI)
# -----------------------------------
GOOGLE_AI_API_KEY=your-google-ai-api-key

# -----------------------------------
# FRONTEND INTEGRATION
# -----------------------------------
FRONTEND_URL=http://localhost:3000

# -----------------------------------
# LOGGING & MONITORING
# -----------------------------------
LOG_LEVEL=info

# -----------------------------------
# FEATURE FLAGS
# -----------------------------------
ENABLE_EMAIL_VERIFICATION=true
ENABLE_RATE_LIMITING=true
ENABLE_REDIS_CACHING=true

# -----------------------------------
# DEVELOPMENT NOTES
# -----------------------------------
# 1. Copy this file to .env and fill in your actual values
# 2. NEVER commit .env file to version control
# 3. Use different values for production environment
# 4. Generate strong, random secrets for JWT keys
# 5. Test all configurations before deploying