        {
          "name": "Get Application Stats",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{candidateToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/applications/stats",
              "host": ["{{baseUrl}}"],
              "path": ["applications", "stats"]
            }
          }
        }
      ]
    }
  ]
}
