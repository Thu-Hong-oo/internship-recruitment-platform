    {
      "listen": "test",
      "script": {
        "exec": [
          "// Global test cases for all AI endpoints",
          "pm.test('Response time is reasonable (< 30s for AI operations)', function () {",
          "    pm.expect(pm.response.responseTime).to.be.below(30000);",
          "});",
          "",
          "pm.test('Content-Type is application/json', function () {",
          "    pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json');",
          "});",
          "",
          "// Success response tests",
          "if (pm.response.code === 200) {",
          "    pm.test('Successful response has correct structure', function () {",
          "        const jsonData = pm.response.json();",
          "        pm.expect(jsonData).to.have.property('success', true);",
          "        pm.expect(jsonData).to.have.property('data');",
          "        pm.expect(jsonData).to.have.property('message');",
          "    });",
          "",
          "    pm.test('Response data is not empty', function () {",
          "        const jsonData = pm.response.json();",
          "        pm.expect(jsonData.data).to.not.be.empty;",
          "    });",
          "}",
          "",
          "// Error response tests",
          "if (pm.response.code >= 400) {",
          "    pm.test('Error response has correct structure', function () {",
          "        const jsonData = pm.response.json();",
          "        pm.expect(jsonData).to.have.property('success', false);",
          "        pm.expect(jsonData).to.have.property('message');",
          "    });",
          "}",
          "",
          "// Rate limit tests",
          "if (pm.response.code === 429) {",
          "    pm.test('Rate limit response is properly formatted', function () {",
          "        const jsonData = pm.response.json();",
          "        pm.expect(jsonData.message).to.include('Too many');",
          "    });",
          "}"
        ],
        "type": "text/javascript"
      }
    }
