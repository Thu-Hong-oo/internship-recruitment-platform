{
  "info": {
    "name": "CV Builder API",
    "description": "Test collection for CV Builder functionality including data collection, template management, and AI-enhanced CV generation",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{candidateToken}}",
        "type": "string"
      }
    ]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "exec": [
          "// Set base URL if not set",
          "if (!pm.environment.get('baseUrl')) {",
          "    pm.environment.set('baseUrl', 'http://localhost:5000');",
          "}"
        ],
        "type": "text/javascript"
      }
    }
  ],
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Login as Candidate",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Login successful', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const responseJson = pm.response.json();",
                  "if (responseJson.success && responseJson.data.token) {",
                  "    pm.environment.set('candidateToken', responseJson.data.token);",
                  "    console.log('Candidate token saved:', responseJson.data.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"candidate@example.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            }
          }
        }
      ]
    },
    {
      "name": "CV Builder Data Management",
      "item": [
        {
          "name": "Get CV Builder Data",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Get CV Builder data successful', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Response has required fields', function () {",
                  "    const responseJson = pm.response.json();",
                  "    pm.expect(responseJson).to.have.property('success');",
                  "    pm.expect(responseJson).to.have.property('data');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/candidates/me/cv-builder",
              "host": ["{{baseUrl}}"],
              "path": ["api", "candidates", "me", "cv-builder"]
            }
          }
        },
        {
          "name": "Update CV Builder Data",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Update CV Builder data successful', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Response indicates success', function () {",
                  "    const responseJson = pm.response.json();",
                  "    pm.expect(responseJson.success).to.be.true;",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"personalInfo\": {\n    \"fullName\": \"Nguyen Van A\",\n    \"email\": \"candidate@example.com\",\n    \"phone\": \"0123456789\",\n    \"address\": \"123 ABC Street, District 1, Ho Chi Minh City\",\n    \"dateOfBirth\": \"1995-05-15\",\n    \"website\": \"https://portfolio.example.com\",\n    \"linkedin\": \"https://linkedin.com/in/nguyen-van-a\",\n    \"github\": \"https://github.com/nguyenvana\"\n  },\n  \"targetJob\": {\n    \"title\": \"Full Stack Developer\",\n    \"industry\": \"Technology\",\n    \"level\": \"mid\",\n    \"salary\": \"15-25 million VND\",\n    \"location\": \"Ho Chi Minh City\"\n  },\n  \"careerObjective\": \"Experienced Full Stack Developer with 3+ years of experience in building scalable web applications using modern technologies.\",\n  \"experience\": [\n    {\n      \"type\": \"fulltime\",\n      \"company\": \"Tech Company ABC\",\n      \"position\": \"Junior Full Stack Developer\",\n      \"location\": \"Ho Chi Minh City\",\n      \"startDate\": \"2022-01\",\n      \"endDate\": \"2024-08\",\n      \"description\": \"Developed and maintained web applications using React, Node.js, and MongoDB\",\n      \"achievements\": [\n        \"Improved application performance by 40%\",\n        \"Led a team of 3 junior developers\",\n        \"Implemented CI/CD pipeline reducing deployment time by 60%\"\n      ],\n      \"skills\": [\"React\", \"Node.js\", \"MongoDB\", \"AWS\"],\n      \"current\": false\n    }\n  ],\n  \"education\": [\n    {\n      \"type\": \"university\",\n      \"institution\": \"University of Technology\",\n      \"degree\": \"Bachelor\",\n      \"field\": \"Computer Science\",\n      \"startYear\": 2018,\n      \"endYear\": 2022,\n      \"gpa\": 3.5,\n      \"achievements\": [\"Dean's List\", \"Best Final Project Award\"],\n      \"coursework\": [\"Data Structures\", \"Algorithms\", \"Database Systems\"]\n    }\n  ],\n  \"skills\": {\n    \"technical\": [\n      {\n        \"name\": \"JavaScript\",\n        \"level\": \"advanced\",\n        \"verified\": true,\n        \"yearsOfExperience\": 3\n      },\n      {\n        \"name\": \"React\",\n        \"level\": \"advanced\",\n        \"verified\": true,\n        \"yearsOfExperience\": 2\n      },\n      {\n        \"name\": \"Node.js\",\n        \"level\": \"intermediate\",\n        \"verified\": false,\n        \"yearsOfExperience\": 2\n      }\n    ],\n    \"soft\": [\n      {\n        \"name\": \"Leadership\",\n        \"level\": \"intermediate\"\n      },\n      {\n        \"name\": \"Communication\",\n        \"level\": \"advanced\"\n      }\n    ],\n    \"languages\": [\n      {\n        \"name\": \"English\",\n        \"level\": \"B2\",\n        \"certification\": \"TOEIC 750\"\n      },\n      {\n        \"name\": \"Vietnamese\",\n        \"level\": \"Native\",\n        \"certification\": null\n      }\n    ]\n  },\n  \"projects\": [\n    {\n      \"title\": \"E-commerce Platform\",\n      \"description\": \"Built a full-stack e-commerce platform with React frontend and Node.js backend\",\n      \"technologies\": [\"React\", \"Node.js\", \"MongoDB\", \"Stripe API\"],\n      \"startDate\": \"2023-01\",\n      \"endDate\": \"2023-06\",\n      \"status\": \"completed\",\n      \"url\": \"https://ecommerce.example.com\",\n      \"github\": \"https://github.com/nguyenvana/ecommerce\",\n      \"achievements\": [\n        \"Integrated payment gateway\",\n        \"Implemented real-time notifications\",\n        \"Achieved 99% uptime\"\n      ]\n    }\n  ],\n  \"certifications\": [\n    {\n      \"name\": \"AWS Certified Developer\",\n      \"issuer\": \"Amazon Web Services\",\n      \"issueDate\": \"2023-08\",\n      \"expiryDate\": \"2026-08\",\n      \"credentialId\": \"AWS-123456\",\n      \"url\": \"https://aws.amazon.com/verification\"\n    }\n  ],\n  \"awards\": [\n    {\n      \"title\": \"Employee of the Month\",\n      \"issuer\": \"Tech Company ABC\",\n      \"date\": \"2023-12\",\n      \"description\": \"Recognized for outstanding performance and leadership\"\n    }\n  ],\n  \"hobbies\": [\"Photography\", \"Travel\", \"Open Source Contributing\"],\n  \"references\": [\n    {\n      \"name\": \"John Smith\",\n      \"position\": \"Senior Developer\",\n      \"company\": \"Tech Company ABC\",\n      \"email\": \"john.smith@techcompany.com\",\n      \"phone\": \"0987654321\",\n      \"relationship\": \"Direct Supervisor\"\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/candidates/me/cv-builder",
              "host": ["{{baseUrl}}"],
              "path": ["api", "candidates", "me", "cv-builder"]
            }
          }
        }
      ]
    },
    {
      "name": "Template Management",
      "item": [
        {
          "name": "Get Available Templates",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Get templates successful', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Templates array is returned', function () {",
                  "    const responseJson = pm.response.json();",
                  "    pm.expect(responseJson.data).to.be.an('array');",
                  "    pm.expect(responseJson.data.length).to.be.above(0);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/candidates/me/cv-builder/templates",
              "host": ["{{baseUrl}}"],
              "path": ["api", "candidates", "me", "cv-builder", "templates"]
            }
          }
        }
      ]
    },
    {
      "name": "CV Preview & Generation",
      "item": [
        {
          "name": "Preview CV - Modern Template",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Preview generated successfully', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('HTML content is returned', function () {",
                  "    const responseJson = pm.response.json();",
                  "    pm.expect(responseJson.data.html).to.be.a('string');",
                  "    pm.expect(responseJson.data.html.length).to.be.above(0);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
