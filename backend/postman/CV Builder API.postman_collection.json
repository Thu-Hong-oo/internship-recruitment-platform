        {
          "name": "Generate Smart CV - AI Enhanced",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('CV generation successful', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('CV data is returned', function () {",
                  "    const responseJson = pm.response.json();",
                  "    pm.expect(responseJson.data.cv).to.have.property('url');",
                  "    pm.expect(responseJson.data.cv).to.have.property('aiOptimized');",
                  "    pm.expect(responseJson.data.cv.aiOptimized).to.be.true;",
                  "});",
                  "",
                  "// Save CV URL for future reference",
                  "const responseJson = pm.response.json();",
                  "if (responseJson.success && responseJson.data.cv.url) {",
                  "    pm.environment.set('generatedCvUrl', responseJson.data.cv.url);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"template\": \"modern\",\n  \"customization\": {\n    \"colors\": {\n      \"primary\": \"#2563eb\",\n      \"secondary\": \"#64748b\",\n      \"accent\": \"#10b981\"\n    },\n    \"fonts\": {\n      \"heading\": \"Inter\",\n      \"body\": \"Inter\"\n    },\n    \"layout\": \"two-column\",\n    \"sectionOrder\": [\n      \"personalInfo\",\n      \"careerObjective\",\n      \"experience\",\n      \"education\",\n      \"skills\",\n      \"projects\",\n      \"certifications\"\n    ],\n    \"highlightSkills\": [\"JavaScript\", \"React\", \"Node.js\"],\n    \"personalBranding\": {\n      \"tagline\": \"Passionate Full Stack Developer\",\n      \"summary\": \"Building innovative web solutions with modern technologies\"\n    }\n  },\n  \"sections\": [\n    \"personalInfo\",\n    \"careerObjective\",\n    \"experience\",\n    \"education\",\n    \"skills\",\n    \"projects\",\n    \"certifications\",\n    \"awards\"\n  ],\n  \"targetJob\": \"Senior Full Stack Developer\",\n  \"format\": \"html\",\n  \"setAsCurrent\": true\n}"
            },\n            "url": {\n              "raw": "{{baseUrl}}/api/candidates/me/cv-builder/generate",\n              "host": ["{{baseUrl}}"],\n              "path": ["api", "candidates", "me", "cv-builder", "generate"]\n            }\n          }\n        },\n        {\n          "name": "Generate Executive CV",\n          "request": {\n            "method": "POST",\n            "header": [\n              {\n                "key": "Content-Type",\n                "value": "application/json"\n              }\n            ],\n            "body": {\n              "mode": "raw",\n              "raw": "{\\n  \\"template\\": \\"executive\\",\\n  \\"customization\\": {\\n    \\"colors\\": {\\n      \\"primary\\": \\"#1f2937\\",\\n      \\"secondary\\": \\"#6b7280\\",\\n      \\"accent\\": \\"#dc2626\\"\\n    },\\n    \\"fonts\\": {\\n      \\"heading\\": \\"Playfair Display\\",\\n      \\"body\\": \\"Source Sans Pro\\"\\n    },\\n    \\"layout\\": \\"single-column\\",\\n    \\"sectionOrder\\": [\\n      \\"personalInfo\\",\\n      \\"careerObjective\\",\\n      \\"experience\\",\\n      \\"education\\",\\n      \\"certifications\\",\\n      \\"awards\\"\\n    ]\\n  },\\n  \\"sections\\": [\\n    \\"personalInfo\\",\\n    \\"careerObjective\\",\\n    \\"experience\\",\\n    \\"education\\",\\n    \\"certifications\\",\\n    \\"awards\\"\\n  ],\\n  \\"targetJob\\": \\"Technical Lead\\",\\n  \\"format\\": \\"pdf\\",\\n  \\"setAsCurrent\\": false\\n}"\n            },\n            "url": {\n              "raw": "{{baseUrl}}/api/candidates/me/cv-builder/generate",\n              "host": ["{{baseUrl}}"],\n              "path": ["api", "candidates", "me", "cv-builder", "generate"]\n            }\n          }\n        }\n      ]\n    },\n    {\n      "name": "Error Handling Tests",\n      "item": [\n        {\n          "name": "Test Invalid Template",\n          "event": [\n            {\n              "listen": "test",\n              "script": {\n                "exec": [\n                  "pm.test('Invalid template returns 400', function () {",\n                  "    pm.response.to.have.status(400);",\n                  "});"\n                ],\n                "type": "text/javascript"\n              }\n            }\n          ],\n          "request": {\n            "method": "POST",\n            "header": [\n              {\n                "key": "Content-Type",\n                "value": "application/json"\n              }\n            ],\n            "body": {\n              "mode": "raw",\n              "raw": "{\\n  \\"template\\": \\"invalid-template\\",\\n  \\"sections\\": [\\"personalInfo\\"]\\n}"\n            },\n            "url": {\n              "raw": "{{baseUrl}}/api/candidates/me/cv-builder/preview",\n              "host": ["{{baseUrl}}"],\n              "path": ["api", "candidates", "me", "cv-builder", "preview"]\n            }\n          }\n        },\n        {\n          "name": "Test Missing Auth Token",\n          "event": [\n            {\n              "listen": "test",\n              "script": {\n                "exec": [\n                  "pm.test('Missing auth returns 401', function () {",\n                  "    pm.response.to.have.status(401);",\n                  "});"\n                ],\n                "type": "text/javascript"\n              }\n            }\n          ],\n          "request": {\n            "auth": {\n              "type": "noauth"\n            },\n            "method": "GET",\n            "header": [],\n            "url": {\n              "raw": "{{baseUrl}}/api/candidates/me/cv-builder",\n              "host": ["{{baseUrl}}"],\n              "path": ["api", "candidates", "me", "cv-builder"]\n            }\n          }\n        }\n      ]\n    }\n  ],\n  "variable": [\n    {\n      "key": "baseUrl",\n      "value": "http://localhost:5000",\n      "type": "string"\n    }\n  ]\n}