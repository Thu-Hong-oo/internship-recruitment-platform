              "raw": "{\n  \"template\": \"creative\",\n  \"customization\": {\n    \"colors\": {\n      \"primary\": \"#8b5cf6\",\n      \"secondary\": \"#f59e0b\",\n      \"accent\": \"#ef4444\"\n    },\n    \"fonts\": {\n      \"heading\": \"Poppins\",\n      \"body\": \"Open Sans\"\n    },\n    \"layout\": \"sidebar\",\n    \"sectionOrder\": [\n      \"personalInfo\",\n      \"skills\",\n      \"experience\",\n      \"projects\",\n      \"education\",\n      \"certifications\"\n    ]\n  },\n  \"sections\": [\n    \"personalInfo\",\n    \"skills\",\n    \"experience\",\n    \"projects\",\n    \"education\"\n  ]\n}"
