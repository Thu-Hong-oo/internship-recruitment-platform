{
  "info": {
    "_postman_id": "8342a660-0288-4eec-9188-ac2c9cfb2b64",
    "name": "Jobs API - Complete Collection",
    "description": "Complete job management endpoints with all routes from jobController",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_exporter_id": "38146107"
  },
  "item": [
    {
      "name": "Public Routes",
      "item": [
        {
          "name": "Get All Jobs",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{api_url}}/jobs?page=1&limit=10&q=developer&location=Ho Chi Minh&skills=react,nodejs&employer={{employer_id}}&status=active&jobType=internship&industry=technology&category=frontend&salaryMin=8000000&salaryMax=15000000&createdFrom=2024-01-01&createdTo=2024-12-31&deadlineFrom=2024-01-01&deadlineTo=2024-12-31&tags=react,frontend&sortBy=createdAt&sortOrder=desc",
              "host": ["{{api_url}}"],
              "path": ["jobs"],
              "query": [
                { "key": "page", "value": "1", "description": "Page number" },
                {
                  "key": "limit",
                  "value": "10",
                  "description": "Items per page"
                },
                {
                  "key": "q",
                  "value": "developer",
                  "description": "Text search query (searches in title, description)"
                },
                {
                  "key": "location",
                  "value": "Ho Chi Minh",
                  "description": "Job location (case insensitive regex)"
                },
                {
                  "key": "skills",
                  "value": "react,nodejs",
                  "description": "Required skills (comma separated, matches any)"
                },
                {
                  "key": "employer",
                  "value": "{{employer_id}}",
                  "description": "Filter by employer Profile ID"
                },
                {
                  "key": "status",
                  "value": "active",
                  "description": "Job status (draft, pending, active, paused, closed, filled, rejected)"
                },
                {
                  "key": "jobType",
                  "value": "internship",
                  "description": "Job type (internship, full-time, part-time, contract, freelance)"
                },
                {
                  "key": "industry",
                  "value": "technology",
                  "description": "Industry (case insensitive regex)"
                },
                {
                  "key": "category",
                  "value": "frontend",
                  "description": "Job category (case insensitive regex)"
                },
                {
                  "key": "salaryMin",
                  "value": "8000000",
                  "description": "Minimum salary filter (jobs with salaryMin >= this value)"
                },
                {
                  "key": "salaryMax",
                  "value": "15000000",
                  "description": "Maximum salary filter (jobs with salaryMax <= this value)"
                },
                {
                  "key": "createdFrom",
                  "value": "2024-01-01",
                  "description": "Filter jobs created from this date (YYYY-MM-DD)"
                },
                {
                  "key": "createdTo",
                  "value": "2024-12-31",
                  "description": "Filter jobs created to this date (YYYY-MM-DD)"
                },
                {
                  "key": "deadlineFrom",
                  "value": "2024-01-01",
                  "description": "Filter jobs with deadline from this date (YYYY-MM-DD)"
                },
                {
                  "key": "deadlineTo",
                  "value": "2024-12-31",
                  "description": "Filter jobs with deadline to this date (YYYY-MM-DD)"
                },
                {
                  "key": "tags",
                  "value": "react,frontend",
                  "description": "Job tags (comma separated, matches any)"
                },
                {
                  "key": "sortBy",
                  "value": "createdAt",
                  "description": "Sort field (createdAt, updatedAt, title, salary, etc.)"
                },
                {
                  "key": "sortOrder",
                  "value": "desc",
                  "description": "Sort order (asc, desc)"
                }
              ]
            },
            "description": "Get all jobs with comprehensive filtering and pagination. Public users only see ACTIVE/OPEN jobs, admin can see all statuses."
          }
        },
        {
          "name": "Get Recent Jobs",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{api_url}}/jobs/recent?limit=5",
              "host": ["{{api_url}}"],
              "path": ["jobs", "recent"],
              "query": [
                {
                  "key": "limit",
                  "value": "5",
                  "description": "Number of recent jobs to fetch"
                }
              ]
            },
            "description": "Get recently posted jobs"
          }
        },
        {
          "name": "Get Job by Slug",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{api_url}}/jobs/slug/{{job_slug}}",
              "host": ["{{api_url}}"],
              "path": ["jobs", "slug", "{{job_slug}}"]
            },
            "description": "Get job details by slug"
          }
        },
        {
          "name": "Get Job by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{api_url}}/jobs/{{job_id}}",
              "host": ["{{api_url}}"],
              "path": ["jobs", "{{job_id}}"]
            },
            "description": "Get job details by ID"
          }
        },
        {
          "name": "Get Job Company Info",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{api_url}}/jobs/{{job_id}}/company",
              "host": ["{{api_url}}"],
              "path": ["jobs", "{{job_id}}", "company"]
            },
            "description": "Get company information for a specific job"
          }
        },
        {
          "name": "Get Job Stats",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{api_url}}/jobs/{{job_id}}/stats",
              "host": ["{{api_url}}"],
              "path": ["jobs", "{{job_id}}", "stats"]
            },
            "description": "Get job statistics (views, applications, etc.)"
          }
        },
        {
          "name": "Increment Job Views",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": \"{{user_id}}\",\n  \"sessionId\": \"{{session_id}}\"\n}"
            },
            "url": {
              "raw": "{{api_url}}/jobs/{{job_id}}/view",
              "host": ["{{api_url}}"],
              "path": ["jobs", "{{job_id}}", "view"]
            },
            "description": "Increment view count for a job"
          }
        }
      ]
    },
    {
      "name": "Employer Routes",
      "item": [
        {
          "name": "Get All My Jobs (Employer)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{employer_token}}"
              }
            ],
            "url": {
              "raw": "{{api_url}}/jobs/employer?page=1&limit=10&status=draft&sortBy=createdAt&sortOrder=desc",
              "host": ["{{api_url}}"],
              "path": ["jobs", "employer"],
              "query": [
                { "key": "page", "value": "1", "description": "Page number" },
                {
                  "key": "limit",
                  "value": "10",
                  "description": "Items per page"
                },
                {
                  "key": "status",
                  "value": "draft",
                  "description": "Filter by job status (draft, pending, active, etc.)"
                },
                {
                  "key": "sortBy",
                  "value": "createdAt",
                  "description": "Sort field"
                },
                {
                  "key": "sortOrder",
                  "value": "desc",
                  "description": "Sort order"
                }
              ]
            },
            "description": "Get all jobs posted by current employer (including drafts and all statuses)"
          }
        },
        {
          "name": "Get Draft Jobs Only",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{employer_token}}"
              }
            ],
            "url": {
              "raw": "{{api_url}}/jobs/drafts?page=1&limit=10&sortBy=updatedAt&sortOrder=desc",
              "host": ["{{api_url}}"],
              "path": ["jobs", "drafts"],
              "query": [
                { "key": "page", "value": "1", "description": "Page number" },
                {
                  "key": "limit",
                  "value": "10",
                  "description": "Items per page"
                },
                {
                  "key": "sortBy",
                  "value": "updatedAt",
                  "description": "Sort field"
                },
                {
                  "key": "sortOrder",
                  "value": "desc",
                  "description": "Sort order"
                }
              ]
            },
            "description": "Get only draft jobs posted by current employer"
          }
        },
        {
          "name": "Create Job",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{employer_token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Frontend Developer Intern\",\n  \"description\": \"Looking for a passionate frontend developer intern to join our dynamic team. You will work on modern web applications using React and Node.js.\",\n  \"skills\": [\"react\", \"javascript\", \"html\", \"css\", \"nodejs\"],\n  \"requirements\": \"- Basic knowledge of React and JavaScript\\n- Understanding of HTML/CSS\\n- Good communication skills\",\n  \"education\": \"Currently pursuing or completed degree in Computer Science or related field\",\n  \"experience\": \"0-1 years of experience or fresh graduate\",\n  \"salary\": \"8000000 - 12000000 VND\",\n  \"location\": \"Ho Chi Minh City\",\n  \"positions\": 2,\n  \"deadline\": \"2024-12-31T23:59:59.000Z\"\n}"
            },
            "url": {
              "raw": "{{api_url}}/jobs",
              "host": ["{{api_url}}"],
              "path": ["jobs"]
            },
            "description": "Create a new job posting (automatically set to DRAFT status)"
          }
        },
        {
          "name": "Update Job",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{employer_token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Senior Frontend Developer\",\n  \"description\": \"Updated job description for senior frontend developer position...\",\n  \"skills\": [\"react\", \"javascript\", \"typescript\", \"css\", \"nodejs\"],\n  \"requirements\": \"- 3+ years experience with React\\n- Strong TypeScript skills\\n- Experience with modern frontend tools\",\n  \"education\": \"Bachelor's degree in Computer Science or related field\",\n  \"experience\": \"3-5 years of frontend development experience\",\n  \"salary\": \"15000000 - 25000000 VND\",\n  \"location\": \"Ho Chi Minh City\",\n  \"positions\": 1,\n  \"deadline\": \"2024-12-31T23:59:59.000Z\"\n}"
            },
            "url": {
              "raw": "{{api_url}}/jobs/{{job_id}}",
              "host": ["{{api_url}}"],
              "path": ["jobs", "{{job_id}}"]
            },
            "description": "Update an existing job"
          }
        },
        {
          "name": "Delete Job",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{employer_token}}"
              }
            ],
            "url": {
              "raw": "{{api_url}}/jobs/{{job_id}}",
              "host": ["{{api_url}}"],
              "path": ["jobs", "{{job_id}}"]
            },
            "description": "Delete a job posting"
          }
        },
        {
          "name": "Get Job Applications",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{employer_token}}"
              }
            ],
            "url": {
              "raw": "{{api_url}}/jobs/{{job_id}}/applications?page=1&limit=10&status=pending",
              "host": ["{{api_url}}"],
              "path": ["jobs", "{{job_id}}", "applications"],
              "query": [
                { "key": "page", "value": "1", "description": "Page number" },
                {
                  "key": "limit",
                  "value": "10",
                  "description": "Items per page"
                },
                {
                  "key": "status",
                  "value": "pending",
                  "description": "Application status filter"
                }
              ]
            },
            "description": "Get all applications for a specific job"
          }
        },
        {
          "name": "Submit Job for Review",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{employer_token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"notes\": \"Please review this job posting for approval\",\n  \"urgentReview\": false\n}"
            },
            "url": {
              "raw": "{{api_url}}/jobs/employer/{{job_id}}/submit",
              "host": ["{{api_url}}"],
              "path": ["jobs", "employer", "{{job_id}}", "submit"]
            },
            "description": "Submit job for admin review and approval (DRAFT -> PENDING)"
          }
        }
      ]
    },
    {
      "name": "Candidate Routes",
      "item": [
        {
          "name": "Apply for Job",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{candidate_token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"coverLetter\": \"Dear Hiring Manager,\\n\\nI am very interested in the Frontend Developer position at your company. I have experience with React and JavaScript, and I am eager to contribute to your team.\\n\\nBest regards,\\nJohn Doe\",\n  \"resumeUrl\": \"https://example.com/resume.pdf\",\n  \"portfolioUrl\": \"https://johndoe-portfolio.com\",\n  \"expectedSalary\": \"10000000\",\n  \"availableStartDate\": \"2024-01-15T00:00:00.000Z\",\n  \"additionalInfo\": \"I am available for immediate interview and can start work within 2 weeks notice.\"\n}"
            },
            "url": {
              "raw": "{{api_url}}/jobs/{{job_id}}/apply",
              "host": ["{{api_url}}"],
              "path": ["jobs", "{{job_id}}", "apply"]
            },
            "description": "Apply for a job posting"
          }
        }
      ]
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:3000",
      "type": "string"
    },
    {
      "key": "api_url",
      "value": "http://localhost:3000/api",
      "type": "string"
    },
    {
      "key": "job_id",
      "value": "",
      "type": "string",
      "description": "Job ID for testing"
    },
    {
      "key": "job_slug",
      "value": "",
      "type": "string",
      "description": "Job slug for testing"
    },
    {
      "key": "employer_id",
      "value": "",
      "type": "string",
      "description": "Employer Profile ID"
    },
    {
      "key": "user_id",
      "value": "",
      "type": "string",
      "description": "User ID for testing"
    },
    {
      "key": "session_id",
      "value": "",
      "type": "string",
      "description": "Session ID for view tracking"
    },
    {
      "key": "employer_token",
      "value": "",
      "type": "string",
      "description": "JWT token for employer authentication"
    },
    {
      "key": "candidate_token",
      "value": "",
      "type": "string",
      "description": "JWT token for candidate authentication"
    },
    {
      "key": "token",
      "value": "",
      "type": "string",
      "description": "General JWT token"
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Set dynamic variables if needed",
          "if (!pm.environment.get('session_id')) {",
          "    pm.environment.set('session_id', 'session_' + Date.now());",
          "}"
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Common tests for all requests",
          "pm.test('Response time is less than 5000ms', function () {",
          "    pm.expect(pm.response.responseTime).to.be.below(5000);",
          "});",
          "",
          "pm.test('Response should be JSON', function () {",
          "    pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json');",
          "});",
          "",
          "// Auto-extract job_id from create job response",
          "if (pm.response.code === 201 && pm.request.url.toString().includes('/jobs') && !pm.request.url.toString().includes('/apply')) {",
          "    const response = pm.response.json();",
          "    if (response.data && response.data._id) {",
          "        pm.environment.set('job_id', response.data._id);",
          "    }",
          "}"
        ]
      }
    }
  ]
}
