{
  "info": {
    "name": "Admin API (Updated)",
    "_postman_id": "admin-api-updated-collection",
    "description": "Admin system management API with PATCH updates for partial modifications",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000/api/admin",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Dashboard",
      "item": [
        {
          "name": "Get System Dashboard",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/dashboard",
              "host": ["{{baseUrl}}"],
              "path": ["dashboard"]
            },
            "description": "Get comprehensive system dashboard data"
          }
        }
      ]
    },
    {
      "name": "User Management",
      "item": [
        {
          "name": "Get All Users",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/users?page=1&limit=20&role=candidate&status=active",
              "host": ["{{baseUrl}}"],
              "path": ["users"],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "20"
                },
                {
                  "key": "role",
                  "value": "candidate",
                  "description": "Filter by role: candidate, employer, admin"
                },
                {
                  "key": "status",
                  "value": "active",
                  "description": "Filter by status: active, disabled"
                }
              ]
            },
            "description": "Get all users with filtering and pagination"
          }
        },
        {
          "name": "Get User By ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/users/:id",
              "host": ["{{baseUrl}}"],
              "path": ["users", ":id"],
              "variable": [
                {
                  "key": "id",
                  "value": "USER_ID"
                }
              ]
            },
            "description": "Get detailed user information by ID"
          }
        },
        {
          "name": "Update User Status",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"disabled\",\n  \"reason\": \"Violation of terms of service\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/users/:id/status",
              "host": ["{{baseUrl}}"],
              "path": ["users", ":id", "status"],
              "variable": [
                {
                  "key": "id",
                  "value": "USER_ID"
                }
              ]
            },
            "description": "Update user account status (active/disabled)"
          }
        },
        {
          "name": "Delete User",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/users/:id",
              "host": ["{{baseUrl}}"],
              "path": ["users", ":id"],
              "variable": [
                {
                  "key": "id",
                  "value": "USER_ID"
                }
              ]
            },
            "description": "Permanently delete a user account"
          }
        }
      ]
    },
    {
      "name": "System Monitoring",
      "item": [
        {
          "name": "Get System Stats",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/stats",
              "host": ["{{baseUrl}}"],
              "path": ["stats"]
            },
            "description": "Get system statistics (users, jobs, applications, etc.)"
          }
        },
        {
          "name": "Get System Logs",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/logs?level=error&limit=100&startDate=2024-01-01",
              "host": ["{{baseUrl}}"],
              "path": ["logs"],
              "query": [
                {
                  "key": "level",
                  "value": "error",
                  "description": "Filter by log level: info, warn, error"
                },
                {
                  "key": "limit",
                  "value": "100"
                },
                {
                  "key": "startDate",
                  "value": "2024-01-01"
                }
              ]
            },
            "description": "Get system logs with filtering"
          }
        },
        {
          "name": "Get System Health",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": ["{{baseUrl}}"],
              "path": ["health"]
            },
            "description": "Check system health status (database, redis, etc.)"
          }
        }
      ]
    },
    {
      "name": "Queue Management",
      "item": [
        {
          "name": "Get Queue Status",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/queues",
              "host": ["{{baseUrl}}"],
              "path": ["queues"]
            },
            "description": "Get status of all background job queues"
          }
        },
        {
          "name": "Clear Queue",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/queues/:queueName",
              "host": ["{{baseUrl}}"],
              "path": ["queues", ":queueName"],
              "variable": [
                {
                  "key": "queueName",
                  "value": "email",
                  "description": "Queue name: email, notification, matching, etc."
                }
              ]
            },
            "description": "Clear all jobs from a specific queue"
          }
        }
      ]
    },
    {
      "name": "System Settings",
      "item": [
        {
          "name": "Get System Settings",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/settings",
              "host": ["{{baseUrl}}"],
              "path": ["settings"]
            },
            "description": "Get current system configuration settings"
          }
        },
        {
          "name": "Update System Settings",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"maintenance\": {\n    \"enabled\": false,\n    \"message\": \"System under maintenance\"\n  },\n  \"registration\": {\n    \"enabled\": true,\n    \"requireEmailVerification\": true\n  },\n  \"features\": {\n    \"aiMatching\": true,\n    \"chat\": true\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/settings",
              "host": ["{{baseUrl}}"],
              "path": ["settings"]
            },
            "description": "Update system settings (partial update)"
          }
        }
      ]
    },
    {
      "name": "Notifications",
      "item": [
        {
          "name": "Send System Notification",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"System Maintenance Alert\",\n  \"message\": \"System will be under maintenance from 2AM to 4AM\",\n  \"type\": \"info\",\n  \"recipients\": \"all\",\n  \"priority\": \"high\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/notifications",
              "host": ["{{baseUrl}}"],
              "path": ["notifications"]
            },
            "description": "Send notification to all or specific users"
          }
        }
      ]
    },
    {
      "name": "Reports",
      "item": [
        {
          "name": "Get System Reports",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/reports?type=monthly&startDate=2024-01-01&endDate=2024-12-31",
              "host": ["{{baseUrl}}"],
              "path": ["reports"],
              "query": [
                {
                  "key": "type",
                  "value": "monthly",
                  "description": "Report type: daily, weekly, monthly"
                },
                {
                  "key": "startDate",
                  "value": "2024-01-01"
                },
                {
                  "key": "endDate",
                  "value": "2024-12-31"
                }
              ]
            },
            "description": "Generate and download system reports"
          }
        }
      ]
    }
  ]
}
