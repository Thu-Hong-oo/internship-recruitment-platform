{
	"info": {
		"_postman_id": "users-api-001",
		"name": "Users API",
		"description": "User management API for account settings, preferences, notifications, and utilities. For role-specific profile operations:\n- Employers: Use Employer_Profile_API.postman_collection.json (/api/employers/profile)\n- Candidates: Use Candidates_API.postman_collection.json (/api/candidates/me)",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"auth": {
		"type": "bearer",
		"bearer": [
			{
				"key": "token",
				"value": "{{user_token}}",
				"type": "string"
			}
		]
	},
	"variable": [
		{
			"key": "base_url",
			"value": "http://localhost:3000/api",
			"type": "string"
		},
		{
			"key": "user_token",
			"value": "",
			"type": "string"
		},
		{
			"key": "employer_token",
			"value": "",
			"type": "string"
		},
		{
			"key": "user_id",
			"value": "",
			"type": "string"
		},
		{
			"key": "notification_id",
			"value": "",
			"type": "string"
		}
	],
	"item": [
		{
			"name": "Avatar & User Info",
			"item": [
				{
					"name": "Upload Avatar",
					"request": {
						"method": "POST",
						"header": [],
						"body": {
							"mode": "formdata",
							"formdata": [
								{
									"key": "avatar",
									"type": "file",
									"src": []
								}
							]
						},
						"url": {
							"raw": "{{base_url}}/users/avatar",
							"host": ["{{base_url}}"],
							"path": ["users", "avatar"]
						},
						"description": "Upload user avatar image (max 5MB)"
					},
					"response": []
				},
				{
					"name": "Get User by ID",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/users/{{user_id}}",
							"host": ["{{base_url}}"],
							"path": ["users", "{{user_id}}"]
						},
						"description": "Get basic user information by ID"
					},
					"response": []
				},
				{
					"name": "Get Public User Profile (Employer Only)",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{employer_token}}",
									"type": "string"
								}
							]
						},
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/users/{{user_id}}/public-profile",
							"host": ["{{base_url}}"],
							"path": ["users", "{{user_id}}", "public-profile"]
						},
						"description": "Get public profile of a candidate (employer/admin only). For detailed profile operations, use role-specific endpoints."
					},
					"response": []
				}
			],
			"description": "Avatar upload and basic user information. For profile management, use role-specific endpoints."
		},
		{
			"name": "Account Management",
			"item": [
				{
					"name": "Change Password",
					"request": {
						"method": "PUT",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"currentPassword\": \"OldPassword123!\",\n  \"newPassword\": \"NewPassword123!\",\n  \"confirmPassword\": \"NewPassword123!\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/users/password",
							"host": ["{{base_url}}"],
							"path": ["users", "password"]
						},
						"description": "Change user password"
					},
					"response": []
				},
				{
					"name": "Link Google Account",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"googleToken\": \"google_oauth_token_here\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/users/link-google",
							"host": ["{{base_url}}"],
							"path": ["users", "link-google"]
						},
						"description": "Link Google account to existing user"
					},
					"response": []
				},
				{
					"name": "Unlink Google Account",
					"request": {
						"method": "DELETE",
						"header": [],
						"url": {
							"raw": "{{base_url}}/users/unlink-google",
							"host": ["{{base_url}}"],
							"path": ["users", "unlink-google"]
						},
						"description": "Unlink Google account from user"
					},
					"response": []
				},
				{
					"name": "Deactivate Account",
					"request": {
						"method": "PUT",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"reason\": \"Taking a break from job search\",\n  \"password\": \"MyPassword123!\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/users/deactivate",
							"host": ["{{base_url}}"],
							"path": ["users", "deactivate"]
						},
						"description": "Deactivate user account"
					},
					"response": []
				},
				{
					"name": "Reactivate Account",
					"request": {
						"method": "PUT",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"password\": \"MyPassword123!\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/users/reactivate",
							"host": ["{{base_url}}"],
							"path": ["users", "reactivate"]
						},
						"description": "Reactivate user account"
					},
					"response": []
				}
			],
			"description": "Account security and management"
		},
		{
			"name": "User Preferences & Stats",
			"item": [
				{
					"name": "Update User Preferences",
					"request": {
						"method": "PUT",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"language\": \"vi\",\n  \"theme\": \"dark\",\n  \"emailNotifications\": true,\n  \"jobAlerts\": true,\n  \"newsletterSubscription\": false\n}"
						},
						"url": {
							"raw": "{{base_url}}/users/preferences",
							"host": ["{{base_url}}"],
							"path": ["users", "preferences"]
						},
						"description": "Update user preferences"
					},
					"response": []
				},
				{
					"name": "Get User Stats",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/users/stats",
							"host": ["{{base_url}}"],
							"path": ["users", "stats"]
						},
						"description": "Get user statistics (applications, saved jobs, etc.)"
					},
					"response": []
				}
			],
			"description": "User preferences and statistics"
		},
		{
			"name": "User Notifications",
			"item": [
				{
					"name": "Get User Notifications",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/users/notifications?page=1&limit=20&read=all",
							"host": ["{{base_url}}"],
							"path": ["users", "notifications"],
							"query": [
								{
									"key": "page",
									"value": "1"
								},
								{
									"key": "limit",
									"value": "20"
								},
								{
									"key": "read",
									"value": "all",
									"description": "all, read, unread"
								}
							]
						},
						"description": "Get all notifications for user"
					},
					"response": []
				},
				{
					"name": "Mark Notification as Read",
					"request": {
						"method": "PUT",
						"header": [],
						"url": {
							"raw": "{{base_url}}/users/notifications/{{notification_id}}/read",
							"host": ["{{base_url}}"],
							"path": ["users", "notifications", "{{notification_id}}", "read"]
						},
						"description": "Mark notification as read by notification ID"
					},
					"response": []
				},
				{
					"name": "Mark All Notifications as Read",
					"request": {
						"method": "PUT",
						"header": [],
						"url": {
							"raw": "{{base_url}}/users/notifications/read-all",
							"host": ["{{base_url}}"],
							"path": ["users", "notifications", "read-all"]
						},
						"description": "Mark all notifications as read"
					},
					"response": []
				},
				{
					"name": "Delete Notification",
					"request": {
						"method": "DELETE",
						"header": [],
						"url": {
							"raw": "{{base_url}}/users/notifications/{{notification_id}}",
							"host": ["{{base_url}}"],
							"path": ["users", "notifications", "{{notification_id}}"]
						},
						"description": "Delete notification by notification ID"
					},
					"response": []
				}
			],
			"description": "User notification operations"
		}
	]
}