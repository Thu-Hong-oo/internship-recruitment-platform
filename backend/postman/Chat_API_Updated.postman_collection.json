{
  "info": {
    "name": "Chat API (Updated)",
    "_postman_id": "chat-api-updated-collection",
    "description": "Real-time chat and messaging API with PATCH updates",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000/api/chat",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Conversations",
      "item": [
        {
          "name": "Create Conversation",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"participantId\": \"USER_ID\",\n  \"initialMessage\": \"Hello, I have a question about the job posting\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/conversations",
              "host": ["{{baseUrl}}"],
              "path": ["conversations"]
            },
            "description": "Create a new conversation with another user"
          }
        },
        {
          "name": "Get User Conversations",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/conversations?page=1&limit=20&archived=false",
              "host": ["{{baseUrl}}"],
              "path": ["conversations"],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "20"
                },
                {
                  "key": "archived",
                  "value": "false",
                  "description": "Filter archived conversations"
                }
              ]
            },
            "description": "Get all conversations for logged-in user"
          }
        },
        {
          "name": "Get Conversation By ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/conversations/:id",
              "host": ["{{baseUrl}}"],
              "path": ["conversations", ":id"],
              "variable": [
                {
                  "key": "id",
                  "value": "CONVERSATION_ID"
                }
              ]
            },
            "description": "Get conversation details"
          }
        },
        {
          "name": "Archive Conversation",
          "request": {
            "method": "PATCH",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/conversations/:id/archive",
              "host": ["{{baseUrl}}"],
              "path": ["conversations", ":id", "archive"],
              "variable": [
                {
                  "key": "id",
                  "value": "CONVERSATION_ID"
                }
              ]
            },
            "description": "Archive a conversation"
          }
        },
        {
          "name": "Unarchive Conversation",
          "request": {
            "method": "PATCH",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/conversations/:id/unarchive",
              "host": ["{{baseUrl}}"],
              "path": ["conversations", ":id", "unarchive"],
              "variable": [
                {
                  "key": "id",
                  "value": "CONVERSATION_ID"
                }
              ]
            },
            "description": "Unarchive a conversation"
          }
        },
        {
          "name": "Mark Messages as Read",
          "request": {
            "method": "PATCH",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/conversations/:id/read",
              "host": ["{{baseUrl}}"],
              "path": ["conversations", ":id", "read"],
              "variable": [
                {
                  "key": "id",
                  "value": "CONVERSATION_ID"
                }
              ]
            },
            "description": "Mark all messages in conversation as read"
          }
        }
      ]
    },
    {
      "name": "Messages",
      "item": [
        {
          "name": "Send Message",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"content\": \"Thank you for your interest in the position\",\n  \"type\": \"text\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/conversations/:id/messages",
              "host": ["{{baseUrl}}"],
              "path": ["conversations", ":id", "messages"],
              "variable": [
                {
                  "key": "id",
                  "value": "CONVERSATION_ID"
                }
              ]
            },
            "description": "Send a message in a conversation"
          }
        },
        {
          "name": "Get Conversation Messages",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/conversations/:id/messages?page=1&limit=50",
              "host": ["{{baseUrl}}"],
              "path": ["conversations", ":id", "messages"],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "50"
                }
              ],
              "variable": [
                {
                  "key": "id",
                  "value": "CONVERSATION_ID"
                }
              ]
            },
            "description": "Get all messages in a conversation"
          }
        },
        {
          "name": "Edit Message",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"content\": \"Updated message content\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/messages/:id",
              "host": ["{{baseUrl}}"],
              "path": ["messages", ":id"],
              "variable": [
                {
                  "key": "id",
                  "value": "MESSAGE_ID"
                }
              ]
            },
            "description": "Edit a message (only your own messages)"
          }
        },
        {
          "name": "Delete Message",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/messages/:id",
              "host": ["{{baseUrl}}"],
              "path": ["messages", ":id"],
              "variable": [
                {
                  "key": "id",
                  "value": "MESSAGE_ID"
                }
              ]
            },
            "description": "Delete a message (only your own messages)"
          }
        }
      ]
    },
    {
      "name": "Stats",
      "item": [
        {
          "name": "Get Unread Message Count",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/unread-count",
              "host": ["{{baseUrl}}"],
              "path": ["unread-count"]
            },
            "description": "Get total unread message count for user"
          }
        }
      ]
    }
  ]
}
