            "url": {
              "raw": "{{base_url}}/api/admin/skills/categories/{{category}}?page=1&limit=50",
              "host": ["{{base_url}}"],
              "path": ["api", "admin", "skills", "categories", "{{category}}"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "50" }
              ]
            }
          }
        },
        {
          "name": "Update Skill Category",
          "request": {
