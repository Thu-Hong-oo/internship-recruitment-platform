              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"category\": \"backend\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/admin/skills/categories/{{skill_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "admin", "skills", "categories", "{{skill_id}}"]
            }
          }
        }
      ]
    },
