              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"stepType\": \"careerObjective\",\n  \"currentData\": {\n    \"targetJob\": \"Full Stack Developer\"\n  },\n  \"context\": {\n    \"experience\": \"3 years\",\n    \"education\": \"Bachelor's in Computer Science\",\n    \"industry\": \"technology\"\n  }\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/ai/suggestions",
              "host": ["{{base_url}}"],
              "path": ["api", "ai", "suggestions"]
            }
          }
        },
        {
