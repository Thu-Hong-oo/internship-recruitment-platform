    }
  ],
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:3000",
      "type": "string",
      "description": "Base URL - Change to http://localhost:5000 if server runs on port 5000"
    },
    {
      "key": "auth_token",
      "value": "",
      "type": "string"
    },
    {
