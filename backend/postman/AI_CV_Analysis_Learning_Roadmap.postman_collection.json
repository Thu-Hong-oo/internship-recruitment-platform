{
  "info": {
    "name": "AI - CV Analysis & Learning Roadmap (NLP)",
    "description": "NLP-based CV analysis, skill gap identification, and personalized learning roadmap generation using Skills and Industries data",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_exporter_id": "internship-platform-ai"
  },
  "item": [
    {
      "name": "CV Analysis",
      "item": [
        {
          "name": "Analyze CV from File",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{auth_token}}"
              }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "cv",
                  "type": "file",
                  "src": "",
                  "description": "CV file (PDF, DOC, DOCX)"
                }
              ]
            },
            "url": {
              "raw": "{{base_url}}/api/ai/analyze-cv",
              "host": ["{{base_url}}"],
              "path": ["api", "ai", "analyze-cv"]
            }
          }
        },
        {
          "name": "Analyze CV from Text",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{auth_token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"rawCVText\": \"CURRICULUM VITAE\\n\\nName: John Doe\\nEmail: john.doe@example.com\\n\\nSKILLS:\\n- JavaScript, React, Node.js\\n- HTML, CSS, Tailwind\\n- MongoDB, PostgreSQL\\n- Git, Docker\\n\\nEXPERIENCE:\\nSoftware Engineer at Tech Company (2021-2023)\\n- Developed web applications using React and Node.js\\n- Implemented RESTful APIs\\n- Collaborated with cross-functional teams\\n\\nEDUCATION:\\nBachelor of Computer Science (2017-2021)\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/ai/analyze-cv-text",
              "host": ["{{base_url}}"],
              "path": ["api", "ai", "analyze-cv-text"]
            }
          }
        }
      ]
    },
    {
      "name": "Job Matching & Analysis",
      "item": [
        {
          "name": "Get Job Recommendations",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{auth_token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"limit\": 10,\n  \"minScore\": 60\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/ai/job-recommendations",
              "host": ["{{base_url}}"],
              "path": ["api", "ai", "job-recommendations"]
            }
          }
        },
        {
          "name": "Analyze Job Match",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{auth_token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"jobId\": \"{{job_id}}\",\n  \"targetJobDescription\": \"We are looking for a Full Stack Developer with 3+ years of experience in React, Node.js, and cloud technologies.\",\n  \"targetJobTitle\": \"Full Stack Developer\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/ai/analyze-job-match",
              "host": ["{{base_url}}"],
              "path": ["api", "ai", "analyze-job-match"]
            }
          }
        },
        {
          "name": "Analyze Job Description",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{auth_token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"jobDescription\": \"We are seeking a talented Full Stack Developer to join our team. You will work on developing scalable web applications using modern technologies.\\n\\nRequired Skills:\\n- 3+ years of experience with React and Node.js\\n- Strong knowledge of TypeScript\\n- Experience with cloud platforms (AWS/Azure)\\n- Proficiency in database design (MongoDB, PostgreSQL)\\n- Understanding of microservices architecture\\n\\nPreferred Skills:\\n- Experience with Docker and Kubernetes\\n- Knowledge of CI/CD pipelines\\n- Familiarity with GraphQL\\n\\nResponsibilities:\\n- Design and implement new features\\n- Write clean, maintainable code\\n- Collaborate with cross-functional teams\\n- Participate in code reviews\",\n  \"targetJob\": \"Full Stack Developer\",\n  \"companyInfo\": {\n    \"name\": \"Tech Innovators Inc.\",\n    \"industry\": \"technology\"\n  }\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/ai/analyze-job-description",
              "host": ["{{base_url}}"],
              "path": ["api", "ai", "analyze-job-description"]
            }
          }
        }
      ]
    },
    {
      "name": "Skill Gap Analysis",
      "item": [
        {
          "name": "Analyze Skill Gaps (with Job Description)",
          "request": {
            "method": "POST",
