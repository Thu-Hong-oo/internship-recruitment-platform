              {
                "key": "Authorization",
                "value": "Bearer {{auth_token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"targetJobDescription\": \"We are looking for a Senior Full Stack Developer with expertise in:\\n- React, Next.js, TypeScript\\n- Node.js, Express, NestJS\\n- MongoDB, PostgreSQL, Redis\\n- AWS services (EC2, S3, Lambda)\\n- Docker, Kubernetes\\n- Microservices architecture\\n- GraphQL and REST APIs\\n- CI/CD pipelines\\n- Agile methodologies\",\n  \"targetJobTitle\": \"Senior Full Stack Developer\",\n  \"industry\": \"technology\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/ai/skill-gap-analysis",
              "host": ["{{base_url}}"],
              "path": ["api", "ai", "skill-gap-analysis"]
            }
          }
        },
        {
          "name": "Analyze Skill Gaps (with Job ID)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{auth_token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"jobId\": \"{{job_id}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/ai/skill-gap-analysis",
              "host": ["{{base_url}}"],
              "path": ["api", "ai", "skill-gap-analysis"]
            }
          }
        }
      ]
