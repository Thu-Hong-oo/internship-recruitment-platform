						"description": "Get company information for a job"
					},
					"response": []
				},
				{
					"name": "Get Job Stats",
					"request": {
						"auth": {
							"type": "noauth"
						},
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/jobs/{{job_id}}/stats",
							"host": ["{{base_url}}"],
							"path": ["jobs", "{{job_id}}", "stats"]
