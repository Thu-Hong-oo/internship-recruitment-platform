					"name": "Increment Job Views",
					"request": {
						"auth": {
							"type": "noauth"
						},
						"method": "POST",
						"header": [],
						"url": {
							"raw": "{{base_url}}/jobs/{{job_id}}/view",
							"host": ["{{base_url}}"],
							"path": ["jobs", "{{job_id}}", "view"]
