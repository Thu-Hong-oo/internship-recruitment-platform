	"item": [
		{
			"name": "Public - Browse Jobs",
			"item": [
				{
					"name": "Get All Jobs",
					"request": {
						"auth": {
							"type": "noauth"
						},
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/jobs?page=1&limit=20&status=published&employmentType=full-time&location=Ho Chi Minh&minSalary=10000000&maxSalary=30000000&experienceLevel=junior&industryCode=technology&skills=React,Node.js&sortBy=createdAt&sortOrder=desc",
							"host": ["{{base_url}}"],
							"path": ["jobs"],
							"query": [
								{
									"key": "page",
									"value": "1",
									"description": "Page number"
								},
								{
									"key": "limit",
									"value": "20",
									"description": "Items per page"
								},
								{
									"key": "status",
									"value": "published",
									"description": "Job status filter"
								},
								{
									"key": "employmentType",
									"value": "full-time",
									"description": "full-time, part-time, contract, internship"
								},
								{
									"key": "location",
									"value": "Ho Chi Minh",
									"description": "City or location"
								},
								{
									"key": "minSalary",
									"value": "10000000",
									"description": "Minimum salary"
								},
								{
									"key": "maxSalary",
									"value": "30000000",
									"description": "Maximum salary"
								},
								{
									"key": "experienceLevel",
									"value": "junior",
									"description": "entry, junior, mid, senior, lead"
								},
								{
									"key": "industryCode",
									"value": "technology",
									"description": "Industry code"
								},
								{
									"key": "skills",
									"value": "React,Node.js",
									"description": "Comma-separated skills"
								},
								{
									"key": "sortBy",
									"value": "createdAt",
									"description": "Sort field"
								},
								{
									"key": "sortOrder",
									"value": "desc",
									"description": "asc or desc"
								}
							]
						},
						"description": "Get all published jobs with advanced filtering options"
					},
					"response": []
				},
				{
					"name": "Get Recent Jobs",
					"request": {
						"auth": {
							"type": "noauth"
						},
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/jobs/recent?limit=10",
							"host": ["{{base_url}}"],
							"path": ["jobs", "recent"],
							"query": [
								{
									"key": "limit",
									"value": "10",
									"description": "Number of recent jobs"
								}
							]
						},
						"description": "Get most recently posted jobs"
					},
					"response": []
				},
				{
					"name": "Get Job by ID",
					"request": {
						"auth": {
							"type": "noauth"
						},
						"method": "GET",
						"header": [],
						"url": {
