					"request": {
						"auth": {
							"type": "noauth"
						},
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/jobs/{{job_id}}/company",
							"host": ["{{base_url}}"],
							"path": ["jobs", "{{job_id}}", "company"]
