@startuml
skinparam backgroundColor #FFFFFF
skinparam linetype ortho

skinparam actor {
  BackgroundColor #E3F2FD
  BorderColor #1976D2
  FontSize 12
  FontColor #000000
}

skinparam usecase {
  BackgroundColor #E3F2FD
  BorderColor #1976D2
  BorderThickness 2
  FontSize 15
  FontColor #000000
}

skinparam rectangle {
  BackgroundColor #B3E5FC
  BorderColor #0277BD
  BorderThickness 3
  FontSize 13
  FontColor #000000
  FontStyle bold
}

skinparam arrow {
  Color #1976D2
  Thickness 1.5
  Padding 15
}

skinparam note {
  BackgroundColor #FFF9C4
  BorderColor #F57F17
}

skinparam usecase<<main>> {
  BackgroundColor #FFE0B2
  BorderColor #FB8C00
  FontColor #E65100
  FontSize 18
  BorderThickness 2
}

left to right direction

actor Admin

rectangle "Hệ thống" {
  (Đăng nhập) <<main>> as UCLogin
  (Đăng xuất) as UCLogout

  (Quản lý tài khoản) <<main>> as UCManageAccount
  (Cập nhật thông tin cá nhân) as UCUpdatePersonalInfo
  (Cập nhật avatar) as UCUpdateAvatar
  (Đổi mật khẩu) as UCChangePassword
 

  (Quản lý người dùng) <<main>> as UCManageUsers
  (Xem danh sách người dùng) as UCViewUserList
  (Tìm kiếm người dùng) as UCSearchUser
  (Xem chi tiết người dùng) as UCViewUserDetail
  (Kích hoạt/Vô hiệu hóa tài khoản) as UCToggleUserStatus
  (Xóa tài khoản người dùng) as UCDeleteUser

  (Quản lý Candidate) <<main>> as UCManageCandidate
  (Xem danh sách Candidate) as UCViewCandidateList
  (Xem thông tin Candidate) as UCViewCandidateInfo
  (Xem CV của Candidate) as UCViewCandidateCV


  (Quản lý Employer) <<main>> as UCManageEmployer
  (Xem danh sách Employer) as UCViewEmployerList
  (Xem thông tin Employer) as UCViewEmployerInfo
  (Duyệt tài khoản Employer) as UCApproveEmployer
  (Từ chối tài khoản Employer) as UCRejectEmployer

  (Quản lý công ty) <<main>> as UCManageCompany
  (Xem danh sách công ty) as UCViewCompanyList
  (Xem chi tiết công ty) as UCViewCompanyDetail
  (Tìm kiếm công ty) as UCSearchCompany
  (Chỉnh sửa thông tin công ty) as UCEditCompany
  (Xóa công ty) as UCDeleteCompany

  (Quản lý bài đăng) <<main>> as UCManageJobPosts
  (Xem danh sách bài đăng) as UCViewJobPostList
  (Tìm kiếm bài đăng) as UCSearchJobPost
  (Xem chi tiết bài đăng) as UCViewJobPostDetail
  (Duyệt bài đăng) as UCApproveJobPost
  (Từ chối bài đăng) as UCRejectJobPost
  (Xóa bài đăng) as UCDeleteJobPost
  (Ẩn/Hiện bài đăng) as UCToggleJobPostVisibility
  

  (Quản lý ngành nghề) <<main>> as UCManageIndustry
  (Xem danh sách ngành nghề) as UCViewIndustryList
  (Thêm ngành nghề) as UCAddIndustry
  (Sửa ngành nghề) as UCEditIndustry
  (Xóa ngành nghề) as UCDeleteIndustry

  (Quản lý gói dịch vụ) <<main>> as UCManagePackages
  (Xem danh sách gói) as UCViewPackageList
  (Thêm gói dịch vụ) as UCAddPackage
  (Sửa gói dịch vụ) as UCEditPackage
  (Xóa gói dịch vụ) as UCDeletePackage
  (Xem lịch sử mua gói) as UCViewPurchaseHistory

  (Xem thống kê hệ thống) <<main>> as UCViewStatistics
  (Thống kê người dùng) as UCUserStatistics
  (Thống kê bài đăng) as UCJobPostStatistics
  (Thống kê doanh thu) as UCRevenueStatistics
  (Xuất báo cáo) as UCExportReport
}

' ===== ADMIN CONNECTIONS =====
Admin --> UCLogin
Admin --> UCLogout
Admin --> UCManageAccount
Admin --> UCManageUsers
Admin --> UCManageCandidate
Admin --> UCManageEmployer
Admin --> UCManageCompany
Admin --> UCManageJobPosts
Admin --> UCManageIndustry
Admin --> UCManagePackages
Admin --> UCViewStatistics

UCLogin ..> UCManageAccount : <<include>>
UCLogin ..> UCManageUsers : <<include>>
UCLogin ..> UCManageCandidate : <<include>>
UCLogin ..> UCManageEmployer : <<include>>
UCLogin ..> UCManageCompany : <<include>>
UCLogin ..> UCManageAccount : <<include>>
UCLogin ..> UCViewStatistics : <<include>>
UCLogin ..> UCManagePackages : <<include>>
UCLogin ..> UCManageIndustry : <<include>>
UCLogin ..> UCManageJobPosts : <<include>>


' ===== 3.1 QUẢN LÝ TÀI KHOẢN =====
UCManageAccount ..> UCUpdatePersonalInfo : <<include>>
UCManageAccount ..> UCUpdateAvatar : <<include>>
UCManageAccount ..> UCChangePassword : <<include>>


' ===== 3.2 QUẢN LÝ NGƯỜI DÙNG =====
UCManageUsers ..> UCViewUserList : <<include>>
UCSearchUser ..> UCViewUserList : <<extend>>
UCViewUserDetail ..> UCViewUserList : <<extend>>
UCToggleUserStatus ..> UCViewUserList : <<extend>>
UCDeleteUser ..> UCViewUserList : <<extend>>

' ===== 3.3 QUẢN LÝ CANDIDATE =====
UCManageCandidate ..> UCViewCandidateList : <<include>>
UCViewCandidateInfo ..> UCViewCandidateList : <<extend>>
UCViewCandidateCV ..> UCViewCandidateList : <<extend>>

' ===== 3.4 QUẢN LÝ EMPLOYER =====
UCManageEmployer ..> UCViewEmployerList : <<include>>
UCViewEmployerInfo ..> UCViewEmployerList : <<extend>>
UCApproveEmployer ..> UCViewEmployerList : <<extend>>
UCRejectEmployer ..> UCViewEmployerList : <<extend>>

' ===== 3.5 QUẢN LÝ CÔNG TY =====
UCManageCompany ..> UCViewCompanyList : <<include>>
UCViewCompanyDetail ..> UCViewCompanyList : <<extend>>
UCSearchCompany ..> UCViewCompanyList : <<extend>>
UCEditCompany ..> UCViewCompanyList : <<extend>>
UCDeleteCompany ..> UCViewCompanyList : <<extend>>

' ===== 3.6 QUẢN LÝ BÀI ĐĂNG TUYỂN DỤNG =====
UCManageJobPosts ..> UCViewJobPostList : <<include>>
UCSearchJobPost ..> UCViewJobPostList : <<extend>>
UCViewJobPostDetail ..> UCViewJobPostList : <<extend>>
UCApproveJobPost ..> UCViewJobPostList : <<extend>>
UCRejectJobPost ..> UCViewJobPostList : <<extend>>
UCDeleteJobPost ..> UCViewJobPostList : <<extend>>
UCToggleJobPostVisibility ..> UCViewJobPostList : <<extend>>

' ===== 3.7 QUẢN LÝ NGÀNH NGHỀ =====
UCManageIndustry ..> UCViewIndustryList : <<include>>
UCAddIndustry ..> UCManageIndustry : <<extend>>
UCEditIndustry ..> UCViewIndustryList : <<extend>>
UCDeleteIndustry ..> UCViewIndustryList : <<extend>>

' ===== 3.8 QUẢN LÝ GÓI DỊCH VỤ =====
UCManagePackages ..> UCViewPackageList : <<include>>
UCAddPackage ..> UCManagePackages : <<extend>>
UCEditPackage ..> UCViewPackageList : <<extend>>
UCDeletePackage ..> UCViewPackageList : <<extend>>
UCViewPurchaseHistory ..> UCManagePackages : <<extend>>

' ===== 3.9 THỐNG KÊ & BÁO CÁO =====
UCViewStatistics ..> UCUserStatistics : <<include>>
UCViewStatistics ..> UCJobPostStatistics : <<include>>
UCViewStatistics ..> UCRevenueStatistics : <<include>>
UCExportReport ..> UCViewStatistics : <<extend>>

@enduml