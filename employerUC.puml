@startuml
skinparam backgroundColor #FFFFFF
skinparam linetype ortho

skinparam actor {
  BackgroundColor #E3F2FD
  BorderColor #1976D2
  FontSize 12
  FontColor #000000
}

skinparam usecase {
  BackgroundColor #E3F2FD
  BorderColor #1976D2
  BorderThickness 2
  FontSize 15
  FontColor #000000
}

skinparam rectangle {
  BackgroundColor #B3E5FC
  BorderColor #0277BD
  BorderThickness 3
  FontSize 13
  FontColor #000000
  FontStyle bold
}

skinparam arrow {
  Color #1976D2
  Thickness 1.5
  Padding 15
}

skinparam note {
  BackgroundColor #FFF9C4
  BorderColor #F57F17
}

skinparam usecase<<main>> {
  BackgroundColor #FFE0B2
  BorderColor #FB8C00
  FontColor #E65100
  FontSize 18
  BorderThickness 2
}

skinparam note {
  BackgroundColor #FFF9C4
  BorderColor #F57F17
}

left to right direction

actor Employer

rectangle "Hệ thống" {
  together {
  ' === AUTHENTICATION ===
  (Đăng ký tài khoản) as UCRegister
  (Xác thực email) as UCVerifyEmail
  (Đăng nhập) as UCLogin
  (Đăng xuất) as UCLogout
  }

  together {
  ' === 2.1 QUẢN LÝ TÀI KHOẢN ===
  (Quản lý tài khoản) <<main>> as UCManageAccount
  (Quản lý thông tin cá nhân) as UCManagePersonalInfo
  (Cập nhật avatar) as UCUpdateAvatar
  (Đổi mật khẩu) as UCChangePassword
  }


  together {
  ' === 2.2 QUẢN LÝ THÔNG TIN CÔNG TY ===
  (Quản lý thông tin công ty) <<main>> as UCManageCompany
  (Cập nhật thông tin công ty) as UCUpdateCompanyInfo
  (Cập nhật logo công ty) as UCUpdateCompanyLogo
  (Cập nhật hình ảnh công ty) as UCUpdateCompanyImages
  }

  ' === 2.3 QUẢN LÝ BÀI ĐĂNG TUYỂN DỤNG ===
  together {
  (Quản lý bài đăng tuyển dụng) <<main>> as UCManageJobPosting
  (Đăng tin tuyển dụng) as UCPostJob
  (Xem danh sách bài đăng) as UCViewJobList
  (Xem chi tiết bài đăng) as UCViewJobDetail
  (Sửa tin tuyển dụng) as UCEditJob
  (Xóa tin tuyển dụng) as UCDeleteJob
  (Ẩn/Hiện tin tuyển dụng) as UCToggleJobVisibility
  (Gia hạn tin tuyển dụng) as UCRenewJob
  }

  together {
  ' === 2.4 QUẢN LÝ GÓI DỊCH VỤ ===
  (Quản lý gói dịch vụ) <<main>> as UCManagePackage
  (Xem các gói dịch vụ) as UCViewPackages
  (Mua gói đăng tin) as UCBuyPackage
  (Xem lịch sử mua gói) as UCViewPackageHistory
  (Kiểm tra số lượng tin còn lại) as UCCheckRemainingPosts
  }



  ' === 2.5 QUẢN LÝ ỨNG VIÊN ===
  together {
  (Quản lý ứng viên) <<main>> as UCManageCandidates
  (Xem danh sách ứng viên) as UCViewCandidateList
  (Xem CV ứng viên) as UCViewCandidateCV
  (Lọc ứng viên) as UCFilterCandidates
  (Tìm kiếm ứng viên) as UCSearchCandidates
  (Xem gợi ý ứng viên) as UCViewCandidateSuggestions
'   (Đánh dấu ứng viên) as UCMarkCandidate
'   (Ghi chú ứng viên) as UCNoteCandidates
'   (Thay đổi trạng thái ứng viên) as UCChangeStatus
  }

  ' === 2.6 QUẢN LÝ THÔNG BÁO ===
  together {
  (Quản lý thông báo) <<main>> as UCManageNotification
  (Nhận thông báo ứng tuyển mới) as UCReceiveApplicationNotif
  (Ẩn thông báo) as UCHideNotification
  (Tắt thông báo) as UCDisableNotification
  }
}

' ===== EMPLOYER CONNECTIONS =====
Employer --> UCRegister
Employer --> UCLogin
Employer --> UCLogout
Employer --> UCManageAccount
Employer --> UCManageCompany
Employer --> UCManageJobPosting
Employer --> UCManagePackage
Employer --> UCManageCandidates
Employer --> UCManageNotification

' ===== AUTHENTICATION =====
UCRegister ..> UCVerifyEmail : <<include>>

' ===== 2.1 QUẢN LÝ TÀI KHOẢN =====
UCManageAccount ..> UCManagePersonalInfo : <<include>>
UCManageAccount ..> UCUpdateAvatar : <<include>>
UCManageAccount ..> UCChangePassword : <<include>>

' ===== 2.2 QUẢN LÝ THÔNG TIN CÔNG TY =====
UCManageCompany ..> UCUpdateCompanyInfo : <<include>>
UCManageCompany ..> UCUpdateCompanyLogo : <<include>>
UCUpdateCompanyImages ..> UCManageCompany : <<extend>>

' ===== 2.3 QUẢN LÝ BÀI ĐĂNG TUYỂN DỤNG =====
UCManageJobPosting ..> UCPostJob : <<include>>
UCManageJobPosting ..> UCViewJobList : <<include>>
UCViewJobDetail ..> UCViewJobList : <<extend>>
UCEditJob ..> UCViewJobList : <<extend>>
UCDeleteJob ..> UCViewJobList : <<extend>>
UCToggleJobVisibility ..> UCViewJobList : <<extend>>
UCRenewJob ..> UCViewJobList : <<extend>>
UCViewCandidateSuggestions ..> UCViewJobDetail : <<>>

' ===== 2.4 QUẢN LÝ GÓI DỊCH VỤ =====
UCManagePackage ..> UCViewPackages : <<include>>
UCManagePackage ..> UCCheckRemainingPosts : <<include>>
UCBuyPackage ..> UCViewPackages : <<extend>>
UCViewPackageHistory ..> UCManagePackage : <<extend>>

' ===== 2.5 QUẢN LÝ ỨNG VIÊN =====
UCManageCandidates ..> UCViewCandidateList : <<include>>
UCViewCandidateCV ..> UCViewCandidateList : <<extend>>
UCFilterCandidates ..> UCViewCandidateList : <<extend>>
UCSearchCandidates ..> UCViewCandidateList : <<extend>>
' UCMarkCandidate ..> UCViewCandidateList : <<extend>>
' UCNoteCandidates ..> UCViewCandidateList : <<extend>>
' UCChangeStatus ..> UCViewCandidateList : <<extend>>

' note right of UCViewCandidateCV
'   Chức năng trả phí
'   Employer phải mua gói
'   để xem CV ứng viên
' end note

' ===== 2.6 QUẢN LÝ THÔNG BÁO =====
UCManageNotification ..> UCReceiveApplicationNotif : <<include>>
UCHideNotification ..> UCManageNotification : <<extend>>
UCDisableNotification ..> UCManageNotification : <<extend>>

@enduml