{
  "info": {
    "name": "CV Builder API - Fixed",
    "description": "Test collection for CV Builder functionality",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{candidateToken}}",
        "type": "string"
      }
    ]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "exec": [
          "if (!pm.environment.get('baseUrl')) {",
          "    pm.environment.set('baseUrl', 'http://localhost:5000');",
          "}"
        ],
        "type": "text/javascript"
      }
    }
  ],
  "item": [
    {
      "name": "🔐 Authentication",
      "item": [
        {
          "name": "Login as Candidate",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Login successful', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const responseJson = pm.response.json();",
                  "if (responseJson.success && responseJson.data.token) {",
                  "    pm.environment.set('candidateToken', responseJson.data.token);",
                  "    console.log('✅ Token saved:', responseJson.data.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"candidate@example.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            },
            "description": "Login để lấy token cho candidate"
          }
        }
      ]
    },
    {
      "name": "🧪 Test Routes",
      "item": [
        {
          "name": "Test CV Builder Routes",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Routes working', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Message returned', function () {",
                  "    const responseJson = pm.response.json();",
                  "    pm.expect(responseJson.message).to.eql('CV Builder routes working');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/candidates/me/cv-builder/test",
              "host": ["{{baseUrl}}"],
              "path": ["api", "candidates", "me", "cv-builder", "test"]
            },
            "description": "Test route không cần auth để kiểm tra routes hoạt động"
          }
        }
      ]
    },
    {
      "name": "📊 CV Builder Data",
      "item": [
        {
          "name": "1. Get CV Builder Data",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Get data successful', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Response has data field', function () {",
                  "    const responseJson = pm.response.json();",
                  "    pm.expect(responseJson).to.have.property('success');",
                  "    pm.expect(responseJson).to.have.property('data');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/candidates/me/cv-builder",
              "host": ["{{baseUrl}}"],
              "path": ["api", "candidates", "me", "cv-builder"]
            },
            "description": "Lấy dữ liệu CV builder hiện tại của user"
          }
        },
        {
          "name": "2. Update CV Builder Data",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Update successful', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Success flag is true', function () {",
                  "    const responseJson = pm.response.json();",
                  "    pm.expect(responseJson.success).to.be.true;",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"personalInfo\": {\n    \"fullName\": \"Nguyen Van Test\",\n    \"email\": \"test@example.com\",\n    \"phone\": \"0123456789\",\n    \"address\": {\n      \"street\": \"123 Test Street\",\n      \"ward\": \"Ward 1\",\n      \"district\": \"District 1\",\n      \"city\": \"Ho Chi Minh City\",\n      \"country\": \"Vietnam\"\n    },\n    \"dateOfBirth\": \"1995-01-01\",\n    \"website\": \"https://test.com\",\n    \"linkedin\": \"https://linkedin.com/in/test\",\n    \"github\": \"https://github.com/test\"\n  },\n  \"targetJob\": {\n    \"title\": \"Full Stack Developer\",\n    \"industry\": \"Technology\",\n    \"level\": \"mid\",\n    \"salary\": \"15-25 million VND\",\n    \"location\": \"Ho Chi Minh City\"\n  },\n  \"careerObjective\": \"Passionate developer with 3+ years experience\",\n  \"experience\": [\n    {\n      \"type\": \"fulltime\",\n      \"company\": \"Tech Corp\",\n      \"position\": \"Developer\",\n      \"location\": \"HCMC\",\n      \"startDate\": \"2022-01\",\n      \"endDate\": \"2024-12\",\n      \"description\": \"Developed web applications\",\n      \"achievements\": [\"Improved performance by 40%\"],\n      \"skills\": [\"React\", \"Node.js\"],\n      \"current\": true\n    }\n  ],\n  \"education\": [\n    {\n      \"type\": \"university\",\n      \"institution\": \"University of Technology\",\n      \"degree\": \"Bachelor\",\n      \"field\": \"Computer Science\",\n      \"startYear\": 2018,\n      \"endYear\": 2022,\n      \"gpa\": 3.5,\n      \"achievements\": [\"Dean's List\"]\n    }\n  ],\n  \"skills\": {\n    \"technical\": [\n      {\n        \"name\": \"JavaScript\",\n        \"level\": \"advanced\",\n        \"verified\": true,\n        \"yearsOfExperience\": 3\n      }\n    ],\n    \"soft\": [\n      {\n        \"name\": \"Communication\",\n        \"level\": \"advanced\"\n      }\n    ],\n    \"languages\": [\n      {\n        \"name\": \"English\",\n        \"level\": \"B2\",\n        \"certification\": \"TOEIC 750\"\n      }\n    ]\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/candidates/me/cv-builder",
              "host": ["{{baseUrl}}"],
              "path": ["api", "candidates", "me", "cv-builder"]
            },
            "description": "Cập nhật dữ liệu CV builder với thông tin mới"
          }
        }
      ]
    },
    {
      "name": "🎨 Templates",
      "item": [
        {
          "name": "Get Available Templates",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Templates retrieved', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Templates array returned', function () {",
                  "    const responseJson = pm.response.json();",
                  "    pm.expect(responseJson.data).to.be.an('array');",
                  "    pm.expect(responseJson.data.length).to.be.above(0);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/candidates/me/cv-builder/templates",
              "host": ["{{baseUrl}}"],
              "path": ["api", "candidates", "me", "cv-builder", "templates"]
            },
            "description": "Lấy danh sách tất cả templates có sẵn"
          }
        }
      ]
    },
    {
      "name": "👁️ Preview & Generate",
      "item": [
        {
          "name": "1. Preview CV - Modern Template",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Preview successful', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('HTML content returned', function () {",
                  "    const responseJson = pm.response.json();",
                  "    pm.expect(responseJson.data).to.have.property('html');",
                  "    pm.expect(responseJson.data.html).to.be.a('string');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"template\": \"modern\",\n  \"customization\": {\n    \"colors\": {\n      \"primary\": \"#2563eb\",\n      \"secondary\": \"#64748b\",\n      \"accent\": \"#10b981\"\n    },\n    \"fonts\": {\n      \"heading\": \"Inter\",\n      \"body\": \"Inter\"\n    },\n    \"layout\": \"two-column\"\n  },\n  \"sections\": [\n    \"personalInfo\",\n    \"careerObjective\",\n    \"experience\",\n    \"education\",\n    \"skills\"\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/candidates/me/cv-builder/preview",
              "host": ["{{baseUrl}}"],
              "path": ["api", "candidates", "me", "cv-builder", "preview"]
            },
            "description": "Preview CV với modern template"
          }
        },
        {
          "name": "2. Preview CV - Classic Template",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"template\": \"classic\",\n  \"customization\": {\n    \"colors\": {\n      \"primary\": \"#1f2937\",\n      \"secondary\": \"#6b7280\",\n      \"accent\": \"#dc2626\"\n    },\n    \"fonts\": {\n      \"heading\": \"Times New Roman\",\n      \"body\": \"Georgia\"\n    },\n    \"layout\": \"single-column\"\n  },\n  \"sections\": [\n    \"personalInfo\",\n    \"careerObjective\",\n    \"experience\",\n    \"education\",\n    \"skills\"\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/candidates/me/cv-builder/preview",
              "host": ["{{baseUrl}}"],
              "path": ["api", "candidates", "me", "cv-builder", "preview"]
            },
            "description": "Preview CV với classic template"
          }
        },
        {
          "name": "3. Generate Smart CV - AI Enhanced",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('CV generation successful', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('CV data returned', function () {",
                  "    const responseJson = pm.response.json();",
                  "    pm.expect(responseJson.data).to.have.property('cv');",
                  "    pm.expect(responseJson.data.cv).to.have.property('url');",
                  "});",
                  "",
                  "// Save CV URL",
                  "const responseJson = pm.response.json();",
                  "if (responseJson.success && responseJson.data.cv.url) {",
                  "    pm.environment.set('generatedCvUrl', responseJson.data.cv.url);",
                  "    console.log('✅ CV URL saved:', responseJson.data.cv.url);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"template\": \"modern\",\n  \"customization\": {\n    \"colors\": {\n      \"primary\": \"#2563eb\",\n      \"secondary\": \"#64748b\",\n      \"accent\": \"#10b981\"\n    },\n    \"fonts\": {\n      \"heading\": \"Inter\",\n      \"body\": \"Inter\"\n    },\n    \"layout\": \"two-column\",\n    \"personalBranding\": {\n      \"tagline\": \"Passionate Full Stack Developer\",\n      \"summary\": \"Building innovative solutions with modern tech\"\n    }\n  },\n  \"sections\": [\n    \"personalInfo\",\n    \"careerObjective\",\n    \"experience\",\n    \"education\",\n    \"skills\"\n  ],\n  \"targetJob\": \"Senior Full Stack Developer\",\n  \"format\": \"html\",\n  \"setAsCurrent\": true\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/candidates/me/cv-builder/generate",
              "host": ["{{baseUrl}}"],
              "path": ["api", "candidates", "me", "cv-builder", "generate"]
            },
            "description": "Tạo CV thông minh với AI enhancement"
          }
        }
      ]
    },
    {
      "name": "❌ Error Tests",
      "item": [
        {
          "name": "Test Unauthorized Access",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Unauthorized returns 401', function () {",
                  "    pm.response.to.have.status(401);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/candidates/me/cv-builder",
              "host": ["{{baseUrl}}"],
              "path": ["api", "candidates", "me", "cv-builder"]
            },
            "description": "Test unauthorized access (no token)"
          }
        },
        {
          "name": "Test Invalid Template",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Invalid template returns error', function () {",
                  "    pm.response.to.have.status.that.is.oneOf([400, 422]);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"template\": \"invalid-template\",\n  \"sections\": [\"personalInfo\"]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/candidates/me/cv-builder/preview",
              "host": ["{{baseUrl}}"],
              "path": ["api", "candidates", "me", "cv-builder", "preview"]
            },
            "description": "Test with invalid template name"
          }
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000",
      "type": "string"
    }
  ]
}
