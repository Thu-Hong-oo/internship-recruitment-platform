                "value": "Bearer {{token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{api_url}}/users/notifications/{{notification_id}}",
              "host": ["{{api_url}}"],
              "path": ["users", "notifications", "{{notification_id}}"]
            },
            "description": "Delete a specific notification"
          }
        }
      ]
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:3000",
      "type": "string"
    },
    {
      "key": "api_url",
      "value": "http://localhost:3000/api",
      "type": "string"
    },
    {
      "key": "user_id",
      "value": "",
