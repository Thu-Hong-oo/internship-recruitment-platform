  "item": [
    {
      "name": "Profile Management",
      "item": [
        {
          "name": "Get User Profile",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{api_url}}/users/profile",
              "host": ["{{api_url}}"],
              "path": ["users", "profile"]
            },
            "description": "Get current user's full profile data"
          }
        },
        {
          "name": "Update Profile", 
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"John Doe Updated\",\n  \"email\": \"john.updated@example.com\",\n  \"phone\": \"+84901234567\",\n  \"dateOfBirth\": \"1995-05-15T00:00:00.000Z\",\n  \"gender\": \"male\",\n  \"location\": {\n    \"city\": \"Ho Chi Minh City\",\n    \"country\": \"Vietnam\"\n  },\n  \"education.university.name\": \"University of Technology\",\n  \"education.university.degree\": \"Bachelor of Computer Science\",\n  \"education.university.graduationYear\": 2020,\n  \"skills.technical\": [\n    {\"name\": \"JavaScript\", \"level\": \"advanced\"},\n    {\"name\": \"React\", \"level\": \"intermediate\"}\n  ],\n  \"preferences.locations\": [\"Ho Chi Minh City\", \"Ha Noi\"],\n  \"preferences.internshipTypes\": [\"full-time\", \"remote\"]\n}"
            },
            "url": {
              "raw": "{{api_url}}/users/profile",
              "host": ["{{api_url}}"],
              "path": ["users", "profile"]
            },
            "description": "Update user profile with nested field support"
          }
        },
        {
          "name": "Upload Avatar",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
                "type": "text"
              }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "avatar",
                  "type": "file",
                  "src": "/path/to/avatar.jpg",
                  "description": "Avatar image file (max 5MB, images only)"
                }
              ]
            },
            "url": {
              "raw": "{{api_url}}/users/avatar",
              "host": ["{{api_url}}"],
              "path": ["users", "avatar"]
            },
            "description": "Upload user avatar image"
          }
        },
        {
          "name": "Change Password",
          "request": {
            "method": "PUT",
            "header": [
