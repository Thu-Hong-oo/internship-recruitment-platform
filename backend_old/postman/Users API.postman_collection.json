                "key": "Authorization",
                "value": "Bearer {{token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{api_url}}/users/notifications?page=1&limit=20&unreadOnly=false",
              "host": ["{{api_url}}"],
              "path": ["users", "notifications"],
              "query": [
                {
                  "key": "page",
